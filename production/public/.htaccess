# Production app - Apache / LiteSpeed rules
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
AddType application/javascript .js

# Large Excel workbooks (the 2026 sheet is ~9 MB). Ignored where PHP runs as FastCGI/LSAPI;
# set the same values in hPanel -> PHP Configuration there.
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    <IfModule LiteSpeed>
        RewriteRule ^api(/.*)?$ - [E=Cache-Control:no-cache]
        RewriteRule ^(api|migrate)\.php - [E=Cache-Control:no-cache]
    </IfModule>
    RewriteRule ^api(/.*)?$ api.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "(^\.|\.(bak|sql|log|ini|sh|md)$)">
    Require all denied
</FilesMatch>
