# Used only when the whole project is uploaded into the web root (e.g. Hostinger public_html).
# Everything is served from /public; app code, config, migrations and storage are never exposed.
Options -Indexes
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|.*\.(sql|md|log|sh))$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    # (/api/* is the JSON API URL, so the api/ code folder is protected by its own .htaccess instead)
    RewriteRule ^(app|migrations|storage|tools|tests)(/|$) - [F,L]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
