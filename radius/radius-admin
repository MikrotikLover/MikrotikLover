# DNS logger: dnsmasq on this server logs every DNS query with the client IP and forwards
# it to the MikroTik (so the router's DNS filters still apply). Router side: mikrotik/dns-logging.rsc
DNSLOG_CONF=$CONF_DIR/dnsmasq.conf
DNSLOG_UNIT=/etc/systemd/system/mikrotiklover-dnslog.service
cmd_dnslog() {
    case ${1:-status} in
    on)
        local up=${2:-}; [ -n "$up" ] || die "usage: radius-admin dnslog on ROUTER_IP   (the MikroTik that does the filtering)"
        valid_ip "$up"; [[ $up != */* ]] || die "ROUTER_IP must be a single address"
        cat > "$DNSLOG_CONF" <<EOF
# Managed by radius-admin (MikrotikLover) — DNS query logger
port=53
bind-dynamic
except-interface=lo
no-resolv
no-hosts
server=$up
cache-size=1000
log-queries=extra
log-async=50
log-facility=DAEMON
user=$(id dnsmasq >/dev/null 2>&1 && echo dnsmasq || echo nobody)
pid-file=/run/mikrotiklover-dnslog.pid
EOF
        if [ -d /run/systemd/system ]; then
            cat > "$DNSLOG_UNIT" <<EOF
[Unit]
Description=MikrotikLover DNS query logger (dnsmasq)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/sbin/dnsmasq -k --conf-file=$DNSLOG_CONF
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
            systemctl daemon-reload
            systemctl enable --now mikrotiklover-dnslog >/dev/null 2>&1
            systemctl restart mikrotiklover-dnslog
        else
            [ -f /run/mikrotiklover-dnslog.pid ] && kill "$(cat /run/mikrotiklover-dnslog.pid)" 2>/dev/null && sleep 1
            dnsmasq --conf-file="$DNSLOG_CONF"
        fi
        ok "DNS logger on (UDP/TCP 53) — forwards to $up. Now import mikrotik/dns-logging.rsc on the router."
        ;;
    off)
        if [ -d /run/systemd/system ]; then systemctl disable --now mikrotiklover-dnslog >/dev/null 2>&1 || true
        elif [ -f /run/mikrotiklover-dnslog.pid ]; then kill "$(cat /run/mikrotiklover-dnslog.pid)" 2>/dev/null || true; fi
        rm -f "$DNSLOG_CONF"
        ok "DNS logger off (remove the dnslog rules on the router, or netwatch disables them)"
        ;;
    status)
        if [ -f "$DNSLOG_CONF" ]; then
            echo "DNS logger: configured, upstream $(sed -n 's/^server=//p' "$DNSLOG_CONF")"
            ss -lunp 2>/dev/null | grep -q 'dnsmasq' && echo "Listening : yes" || echo "Listening : NO (check: journalctl -u mikrotiklover-dnslog)"
            [ -r /var/log/mikrotik/dns.log ] && echo "Queries today: $(grep -c "^$(date +%F)" /var/log/mikrotik/dns.log || true)"
        else
            echo "DNS logger: off  (radius-admin dnslog on ROUTER_IP)"
        fi
        ;;
    *) die "usage: radius-admin dnslog on ROUTER_IP | off | status" ;;
    esac
}

# ======================================================================= data usage per site / IP / user
hb() { # SQL: human readable bytes for expression $1
    echo "CASE WHEN $1 >= 1073741824 THEN CONCAT(ROUND($1/1073741824,2),' GB')
               WHEN $1 >= 1048576 THEN CONCAT(ROUND($1/1048576,1),' MB')
               ELSE CONCAT(ROUND($1/1024),' KB') END"
}

TRAFFIC_UNIT=/etc/systemd/system/mikrotiklover-traffic.service
cmd_traffic() {
    local by=site days=1 top=30 user="" ip="" site=""
    case ${1:-} in
        now) shift; report_args "$@"; report now "$@"; return ;;
        collector) shift; cmd_collector "$@"; return ;;
    esac
    while [ $# -gt 0 ]; do
        case $1 in
            --by)    by=${2:-}; [[ $by =~ ^(site|ip|user|day|hour)$ ]] || die "--by site|ip|user|day|hour"; shift 2 ;;
            --days)  days=${2:-}; valid_int "$days" days; shift 2 ;;
            --top)   top=${2:-}; valid_int "$top" top; shift 2 ;;
            -u|--user) user=${2:-}; valid_name "$user" username; shift 2 ;;
            --ip)    ip=${2:-}; valid_ip "$ip"; shift 2 ;;
            --site)  site=${2:-}; [[ $site =~ ^[A-Za-z0-9.-]{1,253}$ ]] || die "Invalid site"; shift 2 ;;
            *) die "usage: radius-admin traffic [--by site|ip|user|day|hour] [--days N] [-u USER] [--ip IP] [--site SITE] [--top N] | now | collector on|off|status" ;;
        esac
    done
    local where="bucket >= NOW() - INTERVAL $days DAY"
    [ -z "$user" ] || where+=" AND username=$(q "$user")"
    [ -z "$ip" ]   || where+=" AND client_ip=$(q "$ip")"
    [ -z "$site" ] || where+=" AND site=$(q "${site,,}")"
    local key label extra=""
    case $by in
        site) key="site"; label="site"; extra=", COUNT(DISTINCT client_ip) AS devices, COALESCE(LEFT(GROUP_CONCAT(DISTINCT NULLIF(username,'') ORDER BY username),40),'-') AS users" ;;
        ip)   key="client_ip"; label="ip"; extra=", COALESCE(MAX(NULLIF(username,'')),'-') AS user, COUNT(DISTINCT site) AS sites" ;;
        user) key="IF(username='','(no login)',username)"; label="user"; extra=", COUNT(DISTINCT client_ip) AS devices, COUNT(DISTINCT site) AS sites" ;;
        day)  key="DATE(bucket)"; label="day"; extra=", COUNT(DISTINCT client_ip) AS devices" ;;
        hour) key="bucket"; label="hour"; extra=", COUNT(DISTINCT client_ip) AS devices" ;;
    esac
    local order="SUM(bytes_down+bytes_up) DESC"
    [[ $by == day || $by == hour ]] && order="$key DESC"
    echo "SELECT $key AS \`$label\`,
                 $(hb 'SUM(bytes_down)') AS download, $(hb 'SUM(bytes_up)') AS upload,
                 $(hb 'SUM(bytes_down+bytes_up)') AS total $extra
          FROM traffic_site WHERE $where
          GROUP BY $key ORDER BY $order LIMIT $top;" | dbt
}

cmd_collector() {
    case ${1:-status} in
    on)
        if [ -d /run/systemd/system ]; then
            cat > "$TRAFFIC_UNIT" <<EOF
[Unit]
Description=MikrotikLover traffic collector (NetFlow v9 / IPFIX -> data per site, IP, user)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/mikrotiklover/flowcollector.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
            systemctl daemon-reload
            systemctl enable --now mikrotiklover-traffic >/dev/null 2>&1
            systemctl restart mikrotiklover-traffic
        else
            pkill -f '^(/usr/bin/)?python3 -I /usr/local/lib/mikrotiklover/flowcollector[.]py' 2>/dev/null || true
            nohup python3 -I /usr/local/lib/mikrotiklover/flowcollector.py >>/var/log/mikrotik/traffic-collector.log 2>&1 &
        fi
        ok "Traffic collector on (UDP 2055). Import mikrotik/traffic-flow.rsc on the router."
        [ -f "$DNSLOG_CONF" ] || echo "   Tip: radius-admin dnslog on ROUTER_IP — without it sites show as IP addresses." >&2
        ;;
    off)
        if [ -d /run/systemd/system ]; then systemctl disable --now mikrotiklover-traffic >/dev/null 2>&1 || true
        else pkill -f '^(/usr/bin/)?python3 -I /usr/local/lib/mikrotiklover/flowcollector[.]py' 2>/dev/null || true; fi
        ok "Traffic collector off"
        ;;
    status)
        if pgrep -f '^(/usr/bin/)?python3 -I /usr/local/lib/mikrotiklover/flowcollector[.]py' >/dev/null; then echo "Collector : running (UDP 2055)"; else echo "Collector : off  (radius-admin traffic collector on)"; fi
        echo "Last hour : $(echo "SELECT CONCAT(COUNT(DISTINCT client_ip),' devices, ', ROUND(SUM(bytes_down+bytes_up)/1048576,1),' MB') FROM traffic_site WHERE bucket >= NOW() - INTERVAL 1 HOUR" | db)"
        ;;
    *) die "usage: radius-admin traffic collector on|off|status" ;;
    esac
}

# ======================================================================= web dashboard accounts
web_exists() { [ "$(echo "SELECT COUNT(*) FROM web_admin WHERE username=$(q "$1")" | db)" != 0 ]; }

cmd_web() {
    case ${1:-list} in
    passwd)
        local u=${2:-}; valid_name "$u" "dashboard user"; shift 2
        PASS=""; [ "${1:-}" = -p ] && PASS=${2:-}
        if [ "$PASS" = - ]; then IFS= read -r PASS || true
        elif [ -z "$PASS" ]; then
            [ -t 0 ] || die "usage: radius-admin web passwd NAME [-p -]"
            local p2; read -r -s -p "New dashboard password for $u: " PASS; echo >&2
            read -r -s -p "Repeat: " p2; echo >&2; [ "$PASS" = "$p2" ] || die "Passwords do not match"
        fi
        [[ ${#PASS} -ge 10 && ${#PASS} -le 256 ]] || die "Dashboard password: at least 10 characters"
        local hash; hash=$(printf '%s\n' "$PASS" | python3 -c 'import sys; from werkzeug.security import generate_password_hash as g; print(g(sys.stdin.readline().rstrip("\n")))') \
            || die "python3-werkzeug missing (install.sh installs it)"
        echo "INSERT INTO web_admin (username,password_hash,role) VALUES ($(q "$u"),$(q "$hash"),'admin')
              ON DUPLICATE KEY UPDATE password_hash=VALUES(password_hash);" | db
        ok "Dashboard account '$u' saved"
        ;;
    role)
        local u=${2:-} r=${3:-}; valid_name "$u" "dashboard user"; [[ $r =~ ^(admin|viewer)$ ]] || die "role: admin | viewer"
        web_exists "$u" || die "No dashboard account '$u' (radius-admin web list)"
        echo "UPDATE web_admin SET role=$(q "$r") WHERE username=$(q "$u");" | db; ok "'$u' is now $r"
        ;;
    del)
        local u=${2:-}; valid_name "$u" "dashboard user"
        web_exists "$u" || die "No dashboard account '$u' (radius-admin web list)"
        [ "$(echo "SELECT COUNT(*) FROM web_admin WHERE role='admin' AND username<>$(q "$u")" | db)" != 0 ] \
            || die "'$u' is the last admin account — make another admin first"
        echo "DELETE FROM web_admin WHERE username=$(q "$u");" | db; ok "Dashboard account '$u' deleted"
        ;;
    list)
        echo "SELECT username, role, created_at, last_login FROM web_admin ORDER BY username;" | dbt ;;
    *) die "usage: radius-admin web passwd NAME | role NAME admin|viewer | del NAME | list" ;;
    esac
}

