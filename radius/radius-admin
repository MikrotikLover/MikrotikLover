# ======================================================================= hotspot business: plans, vouchers, subscriptions
parse_duration() { # 30d 12h 90m 45s or plain seconds -> seconds ("0" allowed)
    [[ $1 =~ ^([0-9]{1,6})([dhms]?)$ ]] || die "Invalid duration '$1' (e.g. 30d, 12h, 90m)"
    local n=${BASH_REMATCH[1]}
    case ${BASH_REMATCH[2]} in d) echo $((n*86400)) ;; h) echo $((n*3600)) ;; m) echo $((n*60)) ;; *) echo "$n" ;; esac
}
parse_size() { # 10G 500M 1T 0 -> bytes
    [[ ${1^^} =~ ^([0-9]{1,6})([KMGT]?)B?$ ]] || die "Invalid size '$1' (e.g. 500M, 10G)"
    local n=${BASH_REMATCH[1]}
    case ${BASH_REMATCH[2]} in K) echo $((n<<10)) ;; M) echo $((n<<20)) ;; G) echo $((n<<30)) ;; T) echo $((n<<40)) ;; *) echo "$n" ;; esac
}
valid_money() { [[ $1 =~ ^[0-9]{1,8}(\.[0-9]{1,2})?$ ]] || die "Invalid price '$1'"; }
plan_exists() { [ -n "$(echo "SELECT 1 FROM ml_plan WHERE name=$(q "$1")" | db)" ]; }

cmd_plan() {
    local sub=${1:-list}; shift || true
    case $sub in
    add|set)
        local p=${1:-}; [ -n "$p" ] || die "usage: radius-admin plan add NAME [--price N] [--validity 30d] [--quota 10G] [--period total|monthly|daily] [--fup 1M/1M] [--daily-time 2h] [--rate 5M/5M] [--devices 1] [--pool NAME] [--description TEXT]"
        shift; valid_name "$p" plan
        local cols="" group_args=()
        while [ $# -gt 0 ]; do
            local v=${2:-}
            [ $# -ge 2 ] || die "Missing value for $1"
            case $1 in
                --price) valid_money "$v"; cols+=",price=$v" ;;
                --validity) cols+=",validity_seconds=$( [ "$v" = - ] && echo 0 || parse_duration "$v")" ;;
                --quota) cols+=",quota_bytes=$( [ "$v" = - ] && echo 0 || parse_size "$v")" ;;
                --period) [[ $v =~ ^(total|monthly|daily)$ ]] || die "--period total|monthly|daily"; cols+=",quota_period='$v'" ;;
                --daily-time) cols+=",daily_seconds=$( [ "$v" = - ] && echo 0 || parse_duration "$v")" ;;
                --description) [[ ${#v} -le 128 && $v =~ ^[[:print:]]*$ ]] || die "Description: max 128 printable characters"
                               cols+=",description=$(q "$v")"; group_args+=(--description "$v") ;;
                --rate) group_args+=(--rate "$v") ;;
                --fup) if [ "$v" = - ]; then cols+=",fup_rate=''"; else
                           [[ $v =~ ^[0-9A-Za-z/\ ]{1,64}$ ]] || die "--fup like 1M/1M"; cols+=",fup_rate=$(q "$v")"; fi ;;
                --pool) group_args+=(--pool "$v") ;;
                --devices) group_args+=(--max-sessions "$v") ;;
                --policy) group_args+=(--policy "$v") ;;
                *) die "Unknown option $1" ;;
            esac
            shift 2
        done
        echo "INSERT INTO ml_plan (name) VALUES ($(q "$p")) ON DUPLICATE KEY UPDATE name=name;
              ${cols:+UPDATE ml_plan SET ${cols#,} WHERE name=$(q "$p");}" | db
        cmd_group add "$p" "${group_args[@]}" >/dev/null   # the plan's RADIUS group (speed, devices, policy)
        ok "Plan '$p' saved"
        cmd_plan show "$p"
        ;;
    show)
        local p=${1:-}; valid_name "$p" plan
        plan_exists "$p" || die "No such plan '$p'"
        echo "SELECT name AS plan, price, IF(validity_seconds=0,'-',CONCAT(ROUND(validity_seconds/86400,2),' days')) AS validity,
                     IF(quota_bytes=0,'unlimited',CONCAT(ROUND(quota_bytes/1073741824,2),' GB / ',quota_period)) AS quota,
                     IF(daily_seconds=0,'-',CONCAT(ROUND(daily_seconds/3600,2),' h/day')) AS daily_time,
                     IF(fup_rate='','-',fup_rate) AS after_quota,
                     COALESCE((SELECT value FROM radgroupreply WHERE groupname=name AND attribute='Mikrotik-Rate-Limit' LIMIT 1),'-') AS speed,
                     COALESCE((SELECT value FROM radgroupcheck WHERE groupname=name AND attribute='Simultaneous-Use' LIMIT 1),'-') AS devices
              FROM ml_plan WHERE name=$(q "$p");" | dbt
        ;;
    list|ls)
        echo "SELECT p.name AS plan, p.price,
                     IF(p.validity_seconds=0,'-',CONCAT(ROUND(p.validity_seconds/86400,2),'d')) AS validity,
                     IF(p.quota_bytes=0,'unlimited',CONCAT(ROUND(p.quota_bytes/1073741824,2),'G/',p.quota_period)) AS quota,
                     IF(p.daily_seconds=0,'-',CONCAT(ROUND(p.daily_seconds/3600,2),'h')) AS per_day,
                     IF(p.fup_rate='','cut',p.fup_rate) AS after_quota,
                     COALESCE((SELECT value FROM radgroupreply WHERE groupname=p.name AND attribute='Mikrotik-Rate-Limit' LIMIT 1),'-') AS speed,
                     (SELECT COUNT(*) FROM ml_account a WHERE a.plan=p.name) AS accounts,
                     (SELECT COUNT(*) FROM ml_account a WHERE a.plan=p.name AND a.first_login IS NOT NULL AND (a.expires_at IS NULL OR a.expires_at > NOW())) AS active
              FROM ml_plan p ORDER BY p.price, p.name;" | dbt
        ;;
    del|delete|rm)
        local p=${1:-} force=${2:-}; valid_name "$p" plan
        [ "$(echo "SELECT COUNT(*) FROM ml_plan WHERE name=$(q "$p")" | db)" != 0 ] || die "No such plan '$p' (radius-admin plan list)"
        local n; n=$(echo "SELECT COUNT(*) FROM ml_account WHERE plan=$(q "$p")" | db)
        [ "$n" = 0 ] || [ "$force" = --force ] || die "$n account(s) use plan '$p' (add --force to delete anyway; they keep working without limits)"
        echo "DELETE FROM ml_plan WHERE name=$(q "$p"); UPDATE ml_account SET plan=NULL WHERE plan=$(q "$p");" | db
        cmd_group del "$p" >/dev/null
        ok "Plan '$p' deleted"
        ;;
    *) die "Unknown: plan $sub (add|show|list|del)" ;;
    esac
}

voucher_code() { # voucher_code LENGTH [digits]
    local alphabet='ABCDEFGHJKMNPQRSTUVWXYZ23456789' n=$1 out="" b
    [ "${2:-}" = digits ] && alphabet='0123456789'
    while [ ${#out} -lt "$n" ]; do
        for b in $(od -An -N32 -tu1 /dev/urandom); do   # rejection sampling: no modulo bias
            (( b < 256 - 256 % ${#alphabet} )) && out+=${alphabet:$(( b % ${#alphabet} )):1}
            [ ${#out} -ge "$n" ] && break
        done
    done
    printf '%s' "$out"
}

cmd_voucher() {
    local sub=${1:-list}; shift || true
    case $sub in
    create|add)
        local p=${1:-} count=${2:-}; [ -n "$p" ] && [ -n "$count" ] || die "usage: radius-admin voucher create PLAN COUNT [--prefix P] [--pin] [--note TEXT] [--by NAME]"
        shift 2; valid_name "$p" plan; valid_int "$count" count; (( count >= 1 && count <= 1000 )) || die "COUNT: 1–1000"
        plan_exists "$p" || die "No such plan '$p' (radius-admin plan add $p ...)"
        local prefix="" pin=0 note="" by="cli"
        while [ $# -gt 0 ]; do
            case $1 in
                --prefix) prefix=${2:-}; [[ $prefix =~ ^[A-Za-z0-9]{0,6}$ ]] || die "--prefix: up to 6 letters/digits"; shift 2 ;;
                --pin) pin=1; shift ;;
                --note) note=${2:-}; [[ ${#note} -le 128 && $note =~ ^[[:print:]]*$ ]] || die "--note: max 128 printable characters"; shift 2 ;;
                --by) by=${2:-}; valid_name "$by" name; shift 2 ;;
                *) die "Unknown option $1" ;;
            esac
        done
        local batch; batch=$(echo "INSERT INTO ml_voucher_batch (plan, count, price, note, created_by)
                                   SELECT name, $count, price, $(q "$note"), $(q "$by") FROM ml_plan WHERE name=$(q "$p");
                                   SELECT LAST_INSERT_ID();" | db)
        local sql="" codes=() i=0 user pass
        declare -A seen=()
        while [ $i -lt "$count" ]; do
            user="$prefix$(voucher_code 6)"
            [ -z "${seen[$user]:-}" ] || continue
            [ -z "$(echo "SELECT 1 FROM radcheck WHERE username=$(q "$user") LIMIT 1" | db)" ] || continue
            seen[$user]=1
            if [ "$pin" = 1 ]; then pass=$user; else pass=$(voucher_code 6 digits); fi
            sql+="($(q "$user"),'Cleartext-Password',':=',$(q "$pass")),"
            codes+=("$user $pass")
            i=$((i+1))
        done
        local ug="" ac=""
        for c in "${codes[@]}"; do
            ug+="($(q "${c%% *}"),$(q "$p"),1),"
            ac+="($(q "${c%% *}"),$(q "$p"),$batch),"
        done
        echo "START TRANSACTION;
              INSERT INTO radcheck (username,attribute,op,value) VALUES ${sql%,};
              INSERT INTO radusergroup (username,groupname,priority) VALUES ${ug%,};
              INSERT INTO ml_account (username,plan,voucher_batch) VALUES ${ac%,};
              COMMIT;" | db
        ok "Batch #$batch: $count voucher(s) for plan '$p'"
        printf '%s\n' "${codes[@]}" | awk 'BEGIN{print "   username  password"} {printf "   %-9s %s\n", $1, $2}'
        echo "   Print cards: dashboard → Vouchers → batch #$batch   (or: radius-admin voucher csv $batch)"
        ;;
    list|ls)
        echo "SELECT b.id AS batch, b.plan, b.price, b.count,
                     SUM(a.first_login IS NULL) AS unused,
                     SUM(a.first_login IS NOT NULL AND (a.expires_at IS NULL OR a.expires_at > NOW())) AS active,
                     COALESCE(SUM(a.expires_at <= NOW()),0) AS expired,
                     ROUND(SUM(a.first_login IS NOT NULL) * b.price, 2) AS sold,
                     b.created_at, b.note
              FROM ml_voucher_batch b LEFT JOIN ml_account a ON a.voucher_batch=b.id
              GROUP BY b.id ORDER BY b.id DESC LIMIT 100;" | dbt
        ;;
    show|csv)
        local b=${1:-}; valid_int "$b" batch
        local sep=$([ "$sub" = csv ] && echo "," || echo "")
        local query="SELECT a.username, (SELECT value FROM radcheck c WHERE c.username=a.username AND c.attribute='Cleartext-Password' LIMIT 1) AS password,
                     CASE WHEN a.first_login IS NULL THEN 'unused' WHEN a.expires_at <= NOW() THEN 'expired' ELSE 'active' END AS status,
                     a.first_login, a.expires_at
              FROM ml_account a WHERE a.voucher_batch=$b ORDER BY a.username;"
        if [ "$sub" = csv ]; then echo "username,password,status,first_login,expires_at"; echo "$query" | db | tr '\t' "$sep" | sed 's/NULL//g'
        else echo "$query" | dbt; fi
        ;;
    del|delete|rm)
        local b=${1:-}; valid_int "$b" batch
        local users; users=$(echo "SELECT username FROM ml_account WHERE voucher_batch=$b AND first_login IS NULL" | db)
        local n=0 u list=""
        for u in $users; do list+="$(q "$u"),"; n=$((n+1)); done
        [ "$n" -gt 0 ] && echo "START TRANSACTION;
              DELETE FROM radcheck WHERE username IN (${list%,}); DELETE FROM radusergroup WHERE username IN (${list%,});
              DELETE FROM radreply WHERE username IN (${list%,}); DELETE FROM ml_account WHERE username IN (${list%,});
              COMMIT;" | db
        [ "$(echo "SELECT COUNT(*) FROM ml_account WHERE voucher_batch=$b" | db)" = 0 ] && echo "DELETE FROM ml_voucher_batch WHERE id=$b;" | db
        ok "Deleted $n unused voucher(s) of batch #$b (used vouchers are kept)"
        ;;
    *) die "Unknown: voucher $sub (create|list|show|csv|del)" ;;
    esac
}

cmd_subscription() { # user plan|renew|expiry|quota|status NAME ...
    local sub=$1 u=${2:-}; shift 2 || true
    valid_name "$u" username; user_exists "$u" || die "No such user '$u'"
    case $sub in
    plan)
        local p=${1:-} free=${2:-}; [ -n "$p" ] || die "usage: radius-admin user plan NAME PLAN|- [--free]"
        if [ "$p" = - ]; then
            echo "DELETE FROM ml_account WHERE username=$(q "$u");" | db
            ok "User '$u' has no plan any more (no expiry/quota)"; return
        fi
        valid_name "$p" plan; plan_exists "$p" || die "No such plan '$p'"
        echo "START TRANSACTION;
              INSERT INTO ml_account (username, plan) VALUES ($(q "$u"), $(q "$p"))
                ON DUPLICATE KEY UPDATE plan=VALUES(plan), first_login=NULL, expires_at=NULL, quota_since=NULL, quota_bytes=NULL, voucher_batch=NULL;
              DELETE FROM radusergroup WHERE username=$(q "$u");
              INSERT INTO radusergroup (username,groupname,priority) VALUES ($(q "$u"),$(q "$p"),1);
              $([ "$free" = --free ] || echo "INSERT INTO ml_sale (username, plan, amount, kind) SELECT $(q "$u"), name, price, 'new' FROM ml_plan WHERE name=$(q "$p");")
              COMMIT;" | db
        ok "User '$u' → plan '$p' (validity starts at the next login)"
        kick_user "$u" quiet
        ;;
    renew)
        local free=${1:-}
        local p; p=$(echo "SELECT plan FROM ml_account WHERE username=$(q "$u")" | db)
        [ -n "$p" ] && [ "$p" != NULL ] || die "User '$u' has no plan (radius-admin user plan $u PLAN)"
        echo "START TRANSACTION;
              UPDATE ml_account a JOIN ml_plan p ON p.name=a.plan
                 SET a.first_login=COALESCE(a.first_login, NOW()),
                     a.expires_at=IF(p.validity_seconds>0, GREATEST(COALESCE(a.expires_at, NOW()), NOW()) + INTERVAL p.validity_seconds SECOND, a.expires_at),
                     a.quota_since=NOW()
               WHERE a.username=$(q "$u");
              $([ "$free" = --free ] || echo "INSERT INTO ml_sale (username, plan, amount, kind) SELECT $(q "$u"), name, price, 'renew' FROM ml_plan WHERE name=$(q "$p");")
              COMMIT;" | db
        ok "User '$u' renewed (plan '$p'); data counter reset"
        cmd_subscription status "$u"
        ;;
    expiry)
        local d=${1:-}; [ -n "$d" ] || die "usage: radius-admin user expiry NAME 'YYYY-MM-DD [HH:MM]'|-"
        if [ "$d" = - ]; then v=NULL; else
            [[ $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$ ]] || die "Date format: YYYY-MM-DD or 'YYYY-MM-DD HH:MM'"
            v=$(q "$d")
        fi
        echo "INSERT INTO ml_account (username, expires_at, first_login) VALUES ($(q "$u"), $v, NOW())
                ON DUPLICATE KEY UPDATE expires_at=$v, first_login=COALESCE(first_login, NOW());" | db
        ok "Expiry of '$u' set to $([ "$d" = - ] && echo none || echo "$d")"
        ;;
    quota)
        local sz=${1:-}; [ -n "$sz" ] || die "usage: radius-admin user quota NAME SIZE|-   (e.g. 20G; - = plan default)"
        local v; if [ "$sz" = - ]; then v=NULL; else v=$(parse_size "$sz"); fi
        echo "INSERT INTO ml_account (username, quota_bytes) VALUES ($(q "$u"), $v) ON DUPLICATE KEY UPDATE quota_bytes=$v;" | db
        ok "Data quota of '$u' set to $([ "$sz" = - ] && echo "plan default" || echo "$sz")"
        ;;
    status)
        echo "SELECT a.username AS user, COALESCE(a.plan,'-') AS plan,
                     CASE WHEN a.first_login IS NULL THEN 'not used yet' WHEN a.expires_at <= NOW() THEN 'EXPIRED' ELSE 'active' END AS state,
                     COALESCE(a.expires_at,'-') AS expires,
                     IF(COALESCE(a.quota_bytes,p.quota_bytes,0)=0,'unlimited',CONCAT(ROUND(COALESCE(a.quota_bytes,p.quota_bytes)/1073741824,2),' GB')) AS quota,
                     ml_check(a.username) AS radius_check
              FROM ml_account a LEFT JOIN ml_plan p ON p.name=a.plan WHERE a.username=$(q "$u");" | dbt
        ;;
    esac
}

# Every 5 minutes (cron): cut off sessions whose package ran out, slow down sessions that used
# their quota on a FUP plan. Needed for PPPoE (no Total-Limit there) and running sessions.
cmd_enforce() {
    quarantine_auto || true
    local verbose=${1:-} rows u uid c rate n_cut=0 n_fup=0
    rows=$(echo "SELECT DISTINCT r.username, r.acctuniqueid, ml_check(r.username)
                 FROM radacct r JOIN ml_account a ON a.username=r.username
                 WHERE r.acctstoptime IS NULL" | db)
    while IFS=$'\t' read -r u uid c; do
        [ -n "$u" ] || continue
        case $c in
            reject:*)
                [ -z "$verbose" ] || echo "cut  $u ($uid): ${c#reject:}"
                nas_request "$u" disconnect "" silent "$uid"; n_cut=$((n_cut + LAST_NAS_OK)) ;;
            fup:*)
                [ -n "$(echo "SELECT 1 FROM ml_fup WHERE acctuniqueid=$(q "$uid")" | db)" ] && continue
                rate=${c#fup:*:}
                [[ $rate =~ ^[0-9A-Za-z/\ ]{1,64}$ ]] || continue
                [ -z "$verbose" ] || echo "fup  $u ($uid) -> $rate"
                nas_request "$u" coa "Mikrotik-Rate-Limit = \"$rate\"" silent "$uid"
                if [ "$LAST_NAS_OK" != 0 ]; then
                    echo "INSERT IGNORE INTO ml_fup (acctuniqueid, username) VALUES ($(q "$uid"), $(q "$u"));" | db
                    n_fup=$((n_fup+1))
                fi ;;
        esac
    done <<<"$rows"
    echo "DELETE FROM ml_fup WHERE applied_at < NOW() - INTERVAL 40 DAY;" | db
    [ -z "$verbose" ] || ok "Enforcer: $n_cut session(s) disconnected, $n_fup slowed to FUP speed"
}

# CDN detective (tools/cdnmap.py): which app is behind a CDN hostname or IP
cmd_cdn() {
    local tool=/usr/local/lib/mikrotiklover/cdnmap.py
    case ${1:-} in
        update) python3 -I "$tool" update ;;
        learn)  python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py run $([ "${CDN_FETCH_TITLES:-1}" = 0 ] && echo --no-titles) ;;
        discovered) python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py apps ;;
        app-rename)
            [[ ${2:-} =~ ^[a-z0-9.-]{1,253}$ ]] && [ -n "${3:-}" ] || die "usage: radius-admin cdn app-rename ID 'New Name' [category]"
            python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py rename "$2" "$3" ${4:+"$4"} ;;
        app-merge)
            [[ ${2:-} =~ ^[a-z0-9.-]{1,253}$ ]] && [ -n "${3:-}" ] || die "usage: radius-admin cdn app-merge ID 'Known App'"
            python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py merge "$2" "$3" ;;
        app-drop)
            [[ ${2:-} =~ ^[a-z0-9.-]{1,253}$ ]] || die "usage: radius-admin cdn app-drop ID"
            python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py drop "$2" ;;
        learned) shift; python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py list "$@" ;;
        reject|unreject)
            [[ ${2:-} =~ ^[A-Za-z0-9.-]{1,253}$ ]] || die "usage: radius-admin cdn $1 DOMAIN"
            python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py "$1" "$2" ;;
        apps)
            python3 -I -c 'import sys; sys.path.insert(0,"/usr/local/lib/mikrotiklover"); import cdnmap
for a, i in sorted(cdnmap.catalog().apps().items()):
    doms = i["domains"]
    n = sum(1 for d in doms if d["source"] == "learned")
    print(f"{a:<28} {len(doms):>4} domains" + (f"  ({n} learned)" if n else ""))' ;;
        rsc)
            [ -n "${2:-}" ] || die "usage: radius-admin cdn rsc 'APP NAME'   (see: radius-admin cdn apps)"
            python3 -I -c 'import sys; sys.path.insert(0,"/usr/local/lib/mikrotiklover"); import cdnmap
try: print(cdnmap.rsc_for(sys.argv[1]), end="")
except ValueError as e: sys.exit(str(e))' "$2" ;;
        unknown)
            local days=${2:-1}; valid_int "$days" days
            echo "SELECT site, ROUND(SUM(bytes_down+bytes_up)/1048576,1) AS MB, COUNT(DISTINCT client_ip) AS devices
                  FROM traffic_site WHERE bucket >= NOW() - INTERVAL $days DAY AND site REGEXP '^[0-9.]+$'
                  GROUP BY site ORDER BY SUM(bytes_down+bytes_up) DESC LIMIT 30;" | dbt
            echo "(IPs without a site name — check one with: radius-admin cdn IP)"
            ;;
        ""|-h|--help) die "usage: radius-admin cdn HOSTNAME|IP | unknown [DAYS] | apps | learned [APP] | learn | reject DOMAIN | rsc APP | update" ;;
        *)
            [[ $1 =~ ^[A-Za-z0-9_.-]{1,253}$ ]] || die "Enter a hostname or an IPv4 address"
            python3 -I "$tool" lookup "$1" ${2:+"$2"} ;;
    esac
}

# Ports & protocols (traffic collector): which ports go in / out, which apps use which ports
cmd_ports() {
    local by=port days=1 top=40 user="" ip="" app=""
    while [ $# -gt 0 ]; do
        case $1 in
            --by)   by=${2:-}; [[ $by =~ ^(port|app|device|in|profile)$ ]] || die "--by port|app|device|in|profile"; shift 2 ;;
            --days) days=${2:-}; valid_int "$days" days; shift 2 ;;
            --top)  top=${2:-}; valid_int "$top" top; shift 2 ;;
            -u|--user) user=${2:-}; valid_name "$user" username; shift 2 ;;
            --ip)   ip=${2:-}; valid_ip "$ip"; shift 2 ;;
            --app)  app=${2:-}; [[ $app =~ ^[A-Za-z0-9.()/\ -]{1,253}$ ]] || die "Invalid app/site"; shift 2 ;;
            *) die "usage: radius-admin ports [--by port|app|device|in|profile] [--days N] [-u USER] [--ip IP] [--app SITE] [--top N]" ;;
        esac
    done
    local where="bucket >= NOW() - INTERVAL $days DAY"
    [ -z "$user" ] || where+=" AND username=$(q "$user")"
    [ -z "$ip" ]   || where+=" AND client_ip=$(q "$ip")"
    [ -z "$app" ]  || where+=" AND site=$(q "${app,,}")"
    local sql
    case $by in
        port) sql="SELECT proto, port, direction, SUM(bytes_down) AS down, SUM(bytes_up) AS up, COUNT(DISTINCT client_ip) AS devices,
                          LEFT(GROUP_CONCAT(DISTINCT site ORDER BY site SEPARATOR ', '),70) AS apps
                   FROM traffic_port WHERE $where GROUP BY proto, port, direction ORDER BY SUM(bytes_down+bytes_up) DESC LIMIT $top" ;;
        app)  sql="SELECT site AS app, proto, port, direction, SUM(bytes_down+bytes_up) AS total, COUNT(DISTINCT client_ip) AS devices
                   FROM traffic_port WHERE $where GROUP BY site, proto, port, direction ORDER BY site, SUM(bytes_down+bytes_up) DESC LIMIT $((top*10))" ;;
        device) sql="SELECT client_ip AS device, MAX(NULLIF(username,'')) AS user, proto, port, direction, SUM(bytes_down+bytes_up) AS total,
                            LEFT(GROUP_CONCAT(DISTINCT site ORDER BY site SEPARATOR ', '),60) AS apps
                     FROM traffic_port WHERE $where GROUP BY client_ip, proto, port, direction ORDER BY client_ip, SUM(bytes_down+bytes_up) DESC LIMIT $((top*10))" ;;
        in)   sql="SELECT client_ip AS lan_device, MAX(NULLIF(username,'')) AS user, proto, port, SUM(bytes_down) AS down, SUM(bytes_up) AS up,
                          SUM(flows) AS flows, MIN(bucket) AS first, MAX(bucket) AS last
                   FROM traffic_port WHERE $where AND direction='in' GROUP BY client_ip, proto, port ORDER BY SUM(bytes_down+bytes_up) DESC LIMIT $top" ;;
        profile) sql="SELECT site AS app, proto, port, direction, bytes, first_seen, last_seen FROM ml_app_port WHERE site NOT REGEXP '^[0-9.]+\$'
                      $( [ -z "$app" ] || echo "AND site=$(q "${app,,}")") ORDER BY site, bytes DESC LIMIT $((top*20))" ;;
    esac
    echo "$sql;" | dbh | python3 -I /usr/local/lib/mikrotiklover/ports.py table
    [ "$by" != in ] || echo "IN = started from the internet towards a LAN device (port-forward, DVR/camera, server). Unknown ones deserve a look."
}

cmd_apps() {
    local sub=list days=7 top=60 user="" ip="" cat="" app=""
    case ${1:-} in update|new|users) sub=$1; shift ;; esac
    if [ "$sub" = update ]; then
        local out; out=$(python3 -I /usr/local/lib/mikrotiklover/appinv.py sql --cnf "$CONF_DIR/my.cnf" --db "$DB_NAME" "$@" 2>&1 >"${TMPDIR:-/tmp}/appinv.$$.sql") \
            || { rm -f "${TMPDIR:-/tmp}/appinv.$$.sql"; die "app inventory failed: $out"; }
        db < "${TMPDIR:-/tmp}/appinv.$$.sql"; rm -f "${TMPDIR:-/tmp}/appinv.$$.sql"
        ok "${out#appinv: }"; return
    fi
    if [ "$sub" = users ]; then
        app=${1:-}; [ -n "$app" ] || die "usage: radius-admin apps users APP [--days N]"; shift
        [ "$(echo "SELECT COUNT(*) FROM ml_app WHERE site=$(q "${app,,}") OR app=$(q "$app")" | db)" != 0 ] \
            || die "No app '$app' seen on the network yet (radius-admin apps)"
    fi
    [ "$sub" != new ] || { [[ ${1:-} =~ ^[0-9]+$ ]] && { days=$1; shift; }; }
    while [ $# -gt 0 ]; do
        case $1 in
            --days) days=${2:-}; valid_int "$days" days; shift 2 ;;
            --top)  top=${2:-}; valid_int "$top" top; shift 2 ;;
            -u|--user) user=${2:-}; valid_name "$user" username; shift 2 ;;
            --ip)   ip=${2:-}; valid_ip "$ip"; shift 2 ;;
            --category) cat=${2:-}; [[ $cat =~ ^[a-z]{2,20}$ ]] || die "Invalid category"; shift 2 ;;
            *) die "usage: radius-admin apps [--days N] [-u USER] [--ip IP] [--category C] [--top N] | apps new [DAYS] | apps users APP | apps update" ;;
        esac
    done
    local w="d.day >= CURDATE() - INTERVAL $days DAY" tw="t.bucket >= CURDATE() - INTERVAL $days DAY"
    [ -z "$user" ] || { w+=" AND d.username=$(q "$user")"; tw+=" AND t.username=$(q "$user")"; }
    [ -z "$ip" ]   || { w+=" AND d.client_ip=$(q "$ip")"; tw+=" AND t.client_ip=$(q "$ip")"; }
    [ -z "$cat" ]  || w+=" AND a.category=$(q "$cat")"
    case $sub in
        list) echo "SELECT a.app, a.category, a.site, COUNT(DISTINCT d.client_ip) AS devices, COUNT(DISTINCT NULLIF(d.username,'')) AS users,
                           SUM(d.queries) AS lookups,
                           (SELECT COALESCE(SUM(t.bytes_down+t.bytes_up),0) FROM traffic_site t WHERE t.site=a.site AND $tw) AS total,
                           DATE(a.first_seen) AS first_seen, DATE_FORMAT(a.last_seen,'%Y-%m-%d %H:%i') AS last_seen,
                           IF(a.first_seen >= NOW() - INTERVAL 7 DAY,'NEW','') AS new
                    FROM ml_app a JOIN ml_app_day d ON d.site=a.site WHERE $w
                    GROUP BY a.site ORDER BY devices DESC, lookups DESC LIMIT $top;" | dbh | python3 -I /usr/local/lib/mikrotiklover/ports.py table
              echo "$(echo "SELECT COUNT(*) FROM ml_app" | db) apps seen on this network so far (radius-admin apps new — the latest ones)" ;;
        new)  echo "SELECT app, category, site, source, first_seen, last_seen,
                           (SELECT COUNT(DISTINCT client_ip) FROM ml_app_day d WHERE d.site=a.site) AS devices
                    FROM ml_app a WHERE first_seen >= NOW() - INTERVAL $days DAY ORDER BY first_seen DESC;" | dbt ;;
        users) echo "SELECT a.app, d.client_ip AS device, MAX(NULLIF(d.username,'')) AS user, SUM(d.queries) AS lookups,
                            (SELECT COALESCE(SUM(t.bytes_down+t.bytes_up),0) FROM traffic_site t WHERE t.site=a.site AND t.client_ip=d.client_ip AND $tw) AS total,
                            MIN(d.day) AS first_day, MAX(d.day) AS last_day
                     FROM ml_app a JOIN ml_app_day d ON d.site=a.site
                     WHERE $w AND (a.site=$(q "${app,,}") OR a.app=$(q "$app"))
                     GROUP BY a.site, d.client_ip ORDER BY lookups DESC LIMIT $top;" | dbh | python3 -I /usr/local/lib/mikrotiklover/ports.py table ;;
    esac
}

# ---------------------------------------------------------------- web-filter policies + router sync
POLICY_DIR=/var/lib/mikrotiklover/policies
ROUTER_DIR=/var/lib/mikrotiklover/router
WF_DIR=/usr/local/lib/mikrotiklover/webfilter

policy_exists() { [ -f "$POLICY_DIR/$1.txt" ]; }
policy_users() { # number of users + groups that use policy $1
    echo "SELECT (SELECT COUNT(*) FROM radreply WHERE attribute='Mikrotik-Address-List' AND value=$(q "policy-$1"))
               + (SELECT COUNT(*) FROM radgroupreply WHERE attribute='Mikrotik-Address-List' AND value=$(q "policy-$1"))" | db
}
router_key_perms() {
    chmod 640 "$ROUTER_DIR/key"
    chgrp "$(id -gn mlweb 2>/dev/null || echo root)" "$ROUTER_DIR/key" 2>/dev/null || true
}

cmd_policy() {
    local sub=${1:-list}; shift || true
    case $sub in
    list|ls)
        local f n groups
        for f in "$POLICY_DIR"/*.txt; do
            [ -f "$f" ] || continue
            n=$(basename "$f" .txt); [ "$n" = README ] && continue
            groups=$(echo "SELECT COALESCE(GROUP_CONCAT(groupname),'') FROM radgroupreply WHERE attribute='Mikrotik-Address-List' AND value=$(q "policy-$n")" | db)
            printf '%-18s %s\n' "$n" "$(head -1 "$f" | sed 's/^# *//')"
            printf '%-18s %s\n' "" "$(grep -v '^[[:space:]]*#' "$f" | grep . | paste -sd ';' | sed 's/;/; /g')"
            printf '%-18s used by %s user(s)/group(s)   groups: %s\n' "" "$(policy_users "$n")" "${groups:--}"
        done ;;
    show)
        local n=${1:-}; valid_policy "$n"; policy_exists "$n" || die "No policy '$n'"
        cat "$POLICY_DIR/$n.txt" ;;
    set)
        # radius-admin policy set NAME < file   (first line "# description", then directives)
        local n=${1:-}; valid_policy "$n"
        [ ! -t 0 ] || die "usage: radius-admin policy set NAME < policy.txt"
        install -d -m 755 "$POLICY_DIR"
        local new old out
        new=$(head -c 20000)
        grep -qv '^[[:space:]]*\(#.*\)\?$' <<<"$new" || die "The policy has no rules"
        ! LC_ALL=C grep -q '[^[:print:][:space:]]' <<<"$new" || die "Only plain text"
        old=""; policy_exists "$n" && old=$(cat "$POLICY_DIR/$n.txt")
        printf '%s\n' "$new" > "$POLICY_DIR/$n.txt"; chmod 644 "$POLICY_DIR/$n.txt"
        if ! out=$(cmd_policy build 2>&1); then
            if [ -n "$old" ]; then printf '%s\n' "$old" > "$POLICY_DIR/$n.txt"; else rm -f "${POLICY_DIR:?}/${n:?}.txt"; fi
            cmd_policy build >/dev/null 2>&1 || true
            die "$(grep -o 'build.sh: .*' <<<"$out" | tail -1 | sed 's/^build.sh: //')"
        fi
        ok "Policy '$n' saved; router rules rebuilt (routers with auto-sync pick it up within 15 minutes)" ;;
    del|delete|rm)
        local n=${1:-}; valid_policy "$n"; policy_exists "$n" || die "No policy '$n'"
        local used; used=$(policy_users "$n")
        [ "$used" = 0 ] || die "Policy '$n' is still used by $used user(s)/group(s) — change them first"
        rm -f "${POLICY_DIR:?}/${n:?}.txt"
        cmd_policy build >/dev/null
        ok "Policy '$n' deleted" ;;
    build)
        install -d -m 755 "$ROUTER_DIR" "$POLICY_DIR"
        exec 9>/run/mikrotiklover-build.lock           # one build at a time (cron + dashboard + CLI)
        flock -w 300 9 || die "another router-rules build is still running"
        local lists; lists=$(mktemp -d)
        { echo "SELECT domain FROM ml_vpn_domain ORDER BY domain" | db 2>/dev/null || true; } | grep -E '^[a-z0-9.-]+$' > "$lists/vpn-domains.txt" || true
        if ! WF_OUT="$lists" POLICY_DIR="$POLICY_DIR" VPN_DOMAINS="$lists/vpn-domains.txt" CDNMAP=/usr/local/lib/mikrotiklover/cdnmap.py \
               QUARANTINE_SERVER="$(setting_get server_ip)" \
               bash "$WF_DIR/build.sh" 2>"$lists/build.log"; then
            cat "$lists/build.log" >&2; rm -rf "${lists:?}"; die "router rules not built"
        fi
        {
            echo "# VPN servers seen on this network$( [ -f /var/lib/mikrotiklover/vpn-public.txt ] && echo ' + public VPN/Tor lists') — radius-admin vpn servers"
            echo "/ip firewall address-list"
            echo "remove [find list=vpn-servers comment~\"^mlsync\"]"
            { echo "SELECT ip, kind FROM ml_vpn_server WHERE ip REGEXP '^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+\$' ORDER BY ip" | db 2>/dev/null || true
              [ ! -f /var/lib/mikrotiklover/vpn-public.txt ] || cat /var/lib/mikrotiklover/vpn-public.txt
            } | awk -F'\t' '$1 ~ /^[0-9.]+(\/[0-9]+)?$/ && !seen[$1]++ { gsub(/["\\$]/, "", $2); printf ":do { /ip firewall address-list add list=vpn-servers address=%s comment=\"mlsync: %s\" } on-error={}\n", $1, substr($2, 1, 60) }'
        } > "$lists/vpn-servers.rsc"
        {
            echo "# Security lists (mikrotik/security.rsc uses them): threat networks + attackers found by the server"
            echo "/ip firewall address-list"
            echo "remove [find list=ml-threats]"
            [ ! -f /var/lib/mikrotiklover/threat-ips.txt ] || awk -F'\t' '$1 ~ /^[0-9.]+(\/[0-9]+)?$/ && !seen[$1]++ { gsub(/["\\$]/, "", $2); printf "add list=ml-threats address=%s comment=\"mlsync: %s\"\n", $1, substr($2, 1, 60) }' /var/lib/mikrotiklover/threat-ips.txt
            echo "remove [find list=ml-quarantine comment~\"^mlsync\"]"
            { echo "SELECT ip, CONCAT('quarantine ', IF(username<>'', username, ip)) FROM ml_quarantine WHERE released_at IS NULL AND ip<>''
                    UNION SELECT r.framedipaddress, CONCAT('quarantine ', q.username) FROM ml_quarantine q JOIN radacct r ON r.username=q.username
                    WHERE q.released_at IS NULL AND q.username<>'' AND r.acctstoptime IS NULL AND r.framedipaddress<>''" | db 2>/dev/null || true; } \
              | awk -F'\t' '$1 ~ /^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$/ && !seen[$1]++ { gsub(/["\\$]/, "", $2); printf ":do { /ip firewall address-list add list=ml-quarantine address=%s comment=\"mlsync: %s\" } on-error={}\n", $1, substr($2, 1, 60) }'
            echo "remove [find list=ml-attackers comment~\"^mlsync\"]"
            if [ "$(setting_get security_autoblock)" = 1 ]; then
                echo "SELECT src_ip, MAX(type) FROM ml_security_event
                      WHERE category IN ('attack','ddos') AND severity='high' AND last_seen >= NOW() - INTERVAL 1 DAY
                        AND src_ip REGEXP '^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+\$'
                        AND NOT (INET_ATON(src_ip) BETWEEN INET_ATON('10.0.0.0') AND INET_ATON('10.255.255.255')
                              OR INET_ATON(src_ip) BETWEEN INET_ATON('172.16.0.0') AND INET_ATON('172.31.255.255')
                              OR INET_ATON(src_ip) BETWEEN INET_ATON('192.168.0.0') AND INET_ATON('192.168.255.255')
                              OR INET_ATON(src_ip) BETWEEN INET_ATON('100.64.0.0') AND INET_ATON('100.127.255.255')
                              OR INET_ATON(src_ip) BETWEEN INET_ATON('127.0.0.0') AND INET_ATON('127.255.255.255'))
                        AND src_ip NOT IN (SELECT nasname FROM nas)
                      GROUP BY src_ip ORDER BY src_ip" | db 2>/dev/null \
                  | awk -F'\t' '$1 ~ /^[0-9.]+$/ { gsub(/["\\$]/, "", $2); printf ":do { /ip firewall address-list add list=ml-attackers address=%s timeout=1d comment=\"mlsync: %s\" } on-error={}\n", $1, substr($2, 1, 60) }'
            fi
        } > "$lists/security.rsc"
        {
            echo "# MikrotikLover router sync — generated by radius-admin policy build. Do not edit on the router."
            cat "$lists/webfilter-policies.rsc"
            echo
            cat "$lists/vpn-servers.rsc"
            echo
            cat "$lists/security.rsc"
        } > "$lists/sync.rsc"
        install -m 644 "$lists/webfilter-policies.rsc" "$lists/vpn-servers.rsc" "$lists/sync.rsc" "$ROUTER_DIR/"
        sha256sum "$ROUTER_DIR/sync.rsc" | cut -c1-16 > "$ROUTER_DIR/version.tmp"
        mv "$ROUTER_DIR/version.tmp" "$ROUTER_DIR/version"; chmod 644 "$ROUTER_DIR/version"
        [ -s "$ROUTER_DIR/key" ] || gen_pass 32 > "$ROUTER_DIR/key"
        router_key_perms
        local nsrv npol
        nsrv=$(grep -c 'list=vpn-servers address=' "$ROUTER_DIR/vpn-servers.rsc" || true)
        npol=$(find "$POLICY_DIR" -maxdepth 1 -name '*.txt' ! -name README.txt | wc -l)
        rm -rf "${lists:?}"
        ok "Router rules built: $npol policies, $nsrv VPN servers, version $(cat "$ROUTER_DIR/version")" ;;
    sync|sync-info)
        [ -s "$ROUTER_DIR/key" ] || cmd_policy build >/dev/null
        local dom; dom=$(echo "SELECT v FROM ml_setting WHERE k='radius_domain'" | db 2>/dev/null || true); dom=${dom:-${RADIUS_DOMAIN:-radius.local}}
        echo "url=https://$dom:${WEB_PORT:-8443}/api/public/router"
        echo "key=$(cat "$ROUTER_DIR/key")"
        echo "version=$(cat "$ROUTER_DIR/version" 2>/dev/null)"
        echo "built=$(date -r "$ROUTER_DIR/sync.rsc" '+%Y-%m-%d %H:%M' 2>/dev/null)" ;;
    new-key)
        install -d -m 755 "$ROUTER_DIR"; gen_pass 32 > "$ROUTER_DIR/key"; router_key_perms
        ok "New router sync key — update the ml-sync script on every router (dashboard → Blocking → Router auto-sync)" ;;
    *) die "usage: radius-admin policy list | show NAME | set NAME < file | del NAME | build | sync | new-key" ;;
    esac
}

# ---------------------------------------------------------------- VPN watch
VPN_IGNORE=/var/lib/mikrotiklover/vpn-ignore.txt
cmd_vpn() {
    local sub=attempts days=7 user="" top=100
    case ${1:-} in attempts|users|servers|domains|scan|update|ignore|unignore) sub=$1; shift ;; esac
    case $sub in
    scan)
        local out sql
        sql=$(mktemp)
        if ! out=$(python3 -I /usr/local/lib/mikrotiklover/vpn.py sql --cnf "$CONF_DIR/my.cnf" --db "$DB_NAME" 2>&1 >"$sql"); then
            rm -f "${sql:?}"; die "VPN scan failed: $out"
        fi
        db < "$sql"; rm -f "${sql:?}"
        ok "${out#vpn: }"; return ;;
    update)
        python3 -I /usr/local/lib/mikrotiklover/vpn.py public /var/lib/mikrotiklover/vpn-public.txt
        cmd_policy build; return ;;
    ignore|unignore)
        local x=${1:-}; [[ $x =~ ^[a-z0-9.-]{1,253}$ ]] || die "usage: radius-admin vpn $sub DOMAIN|IP"
        touch "$VPN_IGNORE"
        if [ "$sub" = ignore ]; then
            grep -qxF "$x" "$VPN_IGNORE" || echo "$x" >> "$VPN_IGNORE"
            echo "DELETE FROM ml_vpn_domain WHERE domain=$(q "$x") OR domain LIKE $(q "%.$x");
                  DELETE FROM ml_vpn_server WHERE ip=$(q "$x") OR why LIKE $(q "DNS %$x");" | db
            ok "$x is not a VPN: removed from the lists, router rules rebuilt"
        else
            grep -vxF "$x" "$VPN_IGNORE" > "$VPN_IGNORE.tmp" || true; mv "$VPN_IGNORE.tmp" "$VPN_IGNORE"
            ok "$x can be detected as a VPN again"
        fi
        cmd_policy build >/dev/null; return ;;
    esac
    while [ $# -gt 0 ]; do
        case $1 in
            --days) days=${2:-}; valid_int "$days" days; shift 2 ;;
            -u|--user) user=${2:-}; valid_name "$user" username; shift 2 ;;
            --top) top=${2:-}; valid_int "$top" top; shift 2 ;;
            *) die "usage: radius-admin vpn [attempts|users|servers|domains] [--days N] [-u USER] | vpn scan | vpn update | vpn ignore|unignore NAME" ;;
        esac
    done
    local w="bucket >= NOW() - INTERVAL $days DAY"
    [ -z "$user" ] || w+=" AND username=$(q "$user")"
    case $sub in
        attempts) echo "SELECT DATE_FORMAT(MAX(last_seen),'%Y-%m-%d %H:%i') AS last, NULLIF(username,'') AS user, client_ip AS device, kind,
                               what, GROUP_CONCAT(DISTINCT source ORDER BY source) AS seen_by, SUM(hits) AS tries,
                               IF(SUM(source='blocked'),'BLOCKED',IF(SUM(source='flow' AND bytes > 200000),'CONNECTED?','-')) AS status
                        FROM ml_vpn_event WHERE $w GROUP BY client_ip, username, kind, what ORDER BY MAX(last_seen) DESC LIMIT $top;" | dbt ;;
        users) echo "SELECT COALESCE(NULLIF(username,''),'(no login)') AS user, GROUP_CONCAT(DISTINCT client_ip) AS devices,
                            GROUP_CONCAT(DISTINCT kind ORDER BY kind SEPARATOR ', ') AS vpn, SUM(hits) AS tries,
                            IF(SUM(source='blocked'),'yes','no') AS blocked, DATE_FORMAT(MIN(first_seen),'%m-%d %H:%i') AS first,
                            DATE_FORMAT(MAX(last_seen),'%m-%d %H:%i') AS last
                     FROM ml_vpn_event WHERE $w GROUP BY COALESCE(NULLIF(username,''),client_ip) ORDER BY SUM(hits) DESC LIMIT $top;" | dbt ;;
        servers) echo "SELECT ip, kind, why, first_seen, last_seen FROM ml_vpn_server ORDER BY last_seen DESC LIMIT $top;" | dbt
                 echo "$(echo "SELECT COUNT(*) FROM ml_vpn_server" | db) VPN server IPs learned$( [ -f /var/lib/mikrotiklover/vpn-public.txt ] && echo " + $(wc -l < /var/lib/mikrotiklover/vpn-public.txt) public networks")" ;;
        domains) echo "SELECT domain, kind, why, first_seen, last_seen FROM ml_vpn_domain ORDER BY last_seen DESC LIMIT $top;" | dbt ;;
    esac
}

# ---------------------------------------------------------------- backup / restore
BACKUP_DIR=${BACKUP_DIR:-/var/backups/mikrotiklover}
RADDB=/etc/freeradius/3.0
# everything that makes this server: settings, certificates, FreeRADIUS, policies, learned lists, dashboard
BACKUP_PATHS=(/etc/mikrotiklover-radius /etc/mikrotiklover-radius-web "$RADDB" /var/lib/mikrotiklover
              /etc/cron.d/mikrotiklover /etc/rsyslog.d/30-mikrotiklover.conf /etc/logrotate.d/mikrotiklover-webfilter
              /etc/nginx/sites-available/mikrotiklover /etc/sudoers.d/mikrotiklover-web
              /etc/systemd/system/mikrotiklover-web.service /etc/systemd/system/mikrotiklover-traffic.service
              /etc/systemd/system/mikrotiklover-dnslog.service)

backup_perms() { # the dashboard may list / download backups (it can already run radius-admin as root)
    install -d -m 750 "$BACKUP_DIR"
    chgrp "$(id -gn mlweb 2>/dev/null || echo root)" "$BACKUP_DIR" "$@" 2>/dev/null || true
}

cmd_backup() {
    [ "${1:-}" != offsite ] || { shift; cmd_offsite "$@"; return; }
    local enc=0 logs=0 quiet=0 keep=${BACKUP_KEEP:-14} tag=manual
    while [ $# -gt 0 ]; do
        case $1 in
            --encrypt) enc=1 ;;
            --with-logs) logs=1 ;;
            --quiet) quiet=1 ;;
            --auto) tag=auto ;;
            --keep) keep=${2:-}; valid_int "$keep" keep; shift ;;
            *) die "usage: radius-admin backup [--encrypt] [--with-logs] [--keep N]" ;;
        esac
        shift
    done
    backup_perms
    local stage name out pass=""
    stage=$(mktemp -d)
    name="mikrotiklover-$tag-$(hostname -s 2>/dev/null || echo server)-$(date +%Y%m%d-%H%M%S)"
    if [ "$enc" = 1 ]; then
        if [ -t 0 ]; then read -r -s -p "Backup password: " pass; echo >&2; else read -r pass || true; fi
        [ ${#pass} -ge 8 ] || { rm -rf "${stage:?}"; die "Backup password: at least 8 characters"; }
    fi
    # database: every table (users, plans, vouchers, sales, accounting, reports, security ...)
    if ! mysqldump --single-transaction --routines --triggers --hex-blob "$DB_NAME" > "$stage/db.sql" 2>"$stage/err"; then
        cat "$stage/err" >&2; rm -rf "${stage:?}"; die "database dump failed"
    fi
    local p list=()
    for p in "${BACKUP_PATHS[@]}"; do [ -e "$p" ] && list+=("${p#/}"); done
    [ "$logs" = 0 ] || { [ -d /var/log/mikrotik ] && list+=(var/log/mikrotik); }
    tar -C / -czf "$stage/files.tar.gz" "${list[@]}" 2>"$stage/err" || { cat "$stage/err" >&2; rm -rf "${stage:?}"; die "file backup failed"; }
    {
        echo "MIKROTIKLOVER_BACKUP=1"
        echo "created=$(date '+%Y-%m-%d %H:%M:%S %z')"
        echo "host=$(hostname -f 2>/dev/null || hostname)"
        echo "db_name=$DB_NAME"
        echo "freeradius=$(freeradius -v 2>/dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+' | head -1)"
        echo "users=$(echo "SELECT COUNT(DISTINCT username) FROM radcheck" | db)"
        echo "paths=${list[*]}"
    } > "$stage/manifest.txt"
    out="$BACKUP_DIR/$name.tar.gz"
    tar -C "$stage" -czf "$stage/all.tar.gz" manifest.txt db.sql files.tar.gz
    if [ "$enc" = 1 ]; then
        out+=".enc"
        printf '%s' "$pass" | openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass stdin -in "$stage/all.tar.gz" -out "$out" \
            || { rm -rf "${stage:?}"; die "encryption failed"; }
    else
        cp "$stage/all.tar.gz" "$out"
    fi
    chmod 640 "$out"; backup_perms "$out"
    rm -rf "${stage:?}"
    # keep the newest $keep backups of this kind
    local old
    ls -1t "$BACKUP_DIR"/mikrotiklover-"$tag"-*.tar.gz* 2>/dev/null | tail -n +"$((keep + 1))" | while IFS= read -r old; do rm -f "${old:?}"; done
    if [ "$tag" = auto ] && offsite_load; then
        run_update "Off-site backup" offsite_send "$out" >/dev/null
    fi
    [ "$quiet" = 1 ] || ok "Backup: $out ($(du -h "$out" | cut -f1))"
    [ "$quiet" = 1 ] || echo "Copy it OFF this server too (USB / another PC / cloud). Restore: radius-admin restore $out"
}

cmd_backups() {
    backup_perms
    local f n=0
    printf '%-62s %8s  %s\n' "file" "size" "created"
    for f in $(ls -1t "$BACKUP_DIR"/mikrotiklover-*.tar.gz* 2>/dev/null); do
        printf '%-62s %8s  %s\n' "$(basename "$f")" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
        n=$((n + 1))
    done
    echo "$n backup(s) in $BACKUP_DIR (automatic: every night, newest 14 kept)"
}

cmd_restore() {
    local file=${1:-} yes=0; shift || true
    [ "${1:-}" = --yes ] && yes=1
    [ -n "$file" ] || die "usage: radius-admin restore FILE [--yes]"
    [ -f "$file" ] || { [ -f "$BACKUP_DIR/$file" ] && file="$BACKUP_DIR/$file"; } || true
    [ -f "$file" ] || die "No such backup: $file"
    local stage; stage=$(mktemp -d)
    if [[ $file == *.enc ]]; then
        local pass
        if [ -t 0 ]; then read -r -s -p "Backup password: " pass; echo >&2; else read -r pass || true; fi
        printf '%s' "$pass" | openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass stdin -in "$file" -out "$stage/all.tar.gz" 2>/dev/null \
            || { rm -rf "${stage:?}"; die "Wrong password (or not a MikrotikLover backup)"; }
    else
        cp "$file" "$stage/all.tar.gz"
    fi
    tar -C "$stage" -xzf "$stage/all.tar.gz" manifest.txt db.sql files.tar.gz 2>/dev/null \
        && grep -q '^MIKROTIKLOVER_BACKUP=1$' "$stage/manifest.txt" || { rm -rf "${stage:?}"; die "Not a MikrotikLover backup: $file"; }
    sed -n 's/^\(created\|host\|users\)=/  \1: /p' "$stage/manifest.txt"
    if [ "$yes" != 1 ]; then
        [ -t 0 ] || { rm -rf "${stage:?}"; die "Add --yes to restore without a question"; }
        local a; read -r -p "Replace ALL settings, users and data of this server with this backup? Type yes: " a
        [ "$a" = yes ] || { rm -rf "${stage:?}"; die "Cancelled"; }
    fi
    echo "Safety copy of the current state first ..."
    cmd_backup --quiet --keep 5 </dev/null >/dev/null 2>&1 || echo "  (could not make the safety copy — continuing)"
    echo "Stopping services ..."
    svc stop freeradius >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then systemctl stop mikrotiklover-web mikrotiklover-traffic mikrotiklover-dnslog >/dev/null 2>&1 || true; fi
    echo "Restoring files ..."
    tar -C / -xzf "$stage/files.tar.gz" || { rm -rf "${stage:?}"; die "file restore failed"; }
    # settings may now point to another database name / passwords
    # shellcheck source=/dev/null
    . "$CONF_DIR/radius.conf"
    echo "Restoring the database ..."
    mysql -e "CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
    mysql "$DB_NAME" < "$stage/db.sql" || { rm -rf "${stage:?}"; die "database restore failed (the safety copy is in $BACKUP_DIR)"; }
    # the database users' passwords must match the restored settings
    local wpass; wpass=$(sed -n 's/^WEB_DB_PASS=//p' /etc/mikrotiklover-radius-web/web.conf 2>/dev/null || true)
    mysql <<EOF
CREATE USER IF NOT EXISTS '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';
ALTER USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';
GRANT SELECT, INSERT, UPDATE, DELETE ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost';
GRANT EXECUTE ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost';
FLUSH PRIVILEGES;
EOF
    if [ -n "$wpass" ]; then
        mysql <<EOF
CREATE USER IF NOT EXISTS 'radius_web'@'localhost' IDENTIFIED BY '$wpass';
ALTER USER 'radius_web'@'localhost' IDENTIFIED BY '$wpass';
GRANT SELECT ON \`$DB_NAME\`.* TO 'radius_web'@'localhost';
GRANT INSERT, UPDATE, DELETE ON \`$DB_NAME\`.web_admin TO 'radius_web'@'localhost';
GRANT INSERT ON \`$DB_NAME\`.web_audit TO 'radius_web'@'localhost';
GRANT INSERT, UPDATE, DELETE ON \`$DB_NAME\`.ml_setting TO 'radius_web'@'localhost';
GRANT EXECUTE ON \`$DB_NAME\`.* TO 'radius_web'@'localhost';
FLUSH PRIVILEGES;
EOF
    fi
    rm -rf "${stage:?}"
    echo "Starting services ..."
    [ ! -d /run/systemd/system ] || systemctl daemon-reload
    svc start freeradius >/dev/null 2>&1 || echo "  ! FreeRADIUS did not start: freeradius -X"
    if [ -d /run/systemd/system ]; then
        local u; for u in mikrotiklover-web mikrotiklover-traffic mikrotiklover-dnslog; do
            systemctl is-enabled "$u" >/dev/null 2>&1 && systemctl start "$u" >/dev/null 2>&1 || true
        done
    fi
    syslog_sync >/dev/null 2>&1 || true
    cmd_policy build >/dev/null 2>&1 || true
    ok "Restored from $(basename "$file"). Check: radius-admin test USER PASSWORD, and the dashboard."
}

# ---------------------------------------------------------------- automatic updates (weekly cron)
UPDATE_STAMP=/var/lib/mikrotiklover/updates.txt
update_stamp() { # update_stamp NAME RESULT
    touch "$UPDATE_STAMP"
    grep -v "^$1	" "$UPDATE_STAMP" > "$UPDATE_STAMP.tmp" || true
    printf '%s\t%s\t%s\n' "$1" "$(date '+%Y-%m-%d %H:%M')" "$2" >> "$UPDATE_STAMP.tmp"
    mv "$UPDATE_STAMP.tmp" "$UPDATE_STAMP"; chmod 644 "$UPDATE_STAMP"
}
run_update() { # run_update NAME command...
    local name=$1; shift
    local out; if out=$("$@" 2>&1); then update_stamp "$name" "ok: $(tail -1 <<<"$out" | sed 's/\x1b\[[0-9;]*m//g' | cut -c1-120)"; echo "✔ $name"
    else update_stamp "$name" "failed: $(tail -1 <<<"$out" | cut -c1-120)"; echo "! $name: $(tail -1 <<<"$out")"; fi
}
cmd_hourly() { # cron, every hour: one run at a time; each job's result is shown in Settings → Automatic updates
    exec 8>/run/mikrotiklover-hourly.lock
    flock -n 8 || { echo "the hourly jobs are still running"; return 0; }
    run_update "Hourly: learn app domains + find new apps" cmd_cdn learn
    run_update "Hourly: app inventory + website names" cmd_apps update
    run_update "Hourly: VPN & proxy scan" cmd_vpn scan
    run_update "Hourly: security scan" cmd_security scan
    run_update "Hourly: router rules" cmd_policy build
}

cmd_update() {
    run_update "App catalog" python3 -I /usr/local/lib/mikrotiklover/cdnmap.py catalog-update ${CATALOG_URL:+"$CATALOG_URL"}
    run_update "IP owner lists (ASN)" python3 -I /usr/local/lib/mikrotiklover/cdnmap.py update
    run_update "New app names (website titles)" python3 -I /usr/local/lib/mikrotiklover/cdnlearn.py titles
    run_update "Threat lists (malware, phishing, botnets)" python3 -I /usr/local/lib/mikrotiklover/sentinel.py update
    [ ! -f /var/lib/mikrotiklover/vpn-public.txt ] || run_update "Public VPN / Tor lists" python3 -I /usr/local/lib/mikrotiklover/vpn.py public /var/lib/mikrotiklover/vpn-public.txt
    threat_dns_reload
    run_update "Router rules" cmd_policy build
}

# ---------------------------------------------------------------- security detective
SEC_BLOCK_CONF=$CONF_DIR/dnsmasq-threats.conf
threat_dns_reload() { # the DNS logger answers 0.0.0.0 for threat names when "security dns-block on"
    [ -f "$DNSLOG_CONF" ] || return 0
    if [ -f "$SEC_BLOCK_CONF" ] && [ -s /var/lib/mikrotiklover/threat-hosts ]; then
        grep -q "^conf-file=$SEC_BLOCK_CONF" "$DNSLOG_CONF" || echo "conf-file=$SEC_BLOCK_CONF" >> "$DNSLOG_CONF"
    else
        sed -i "\#^conf-file=$SEC_BLOCK_CONF#d" "$DNSLOG_CONF"
    fi
    if [ -d /run/systemd/system ]; then systemctl restart mikrotiklover-dnslog >/dev/null 2>&1 || true
    elif [ -f /run/mikrotiklover-dnslog.pid ]; then
        kill "$(cat /run/mikrotiklover-dnslog.pid)" 2>/dev/null || true; sleep 1; dnsmasq --conf-file="$DNSLOG_CONF" || true
    fi
}
setting_get() { echo "SELECT v FROM ml_setting WHERE k=$(q "$1")" | db 2>/dev/null || true; }
setting_set() { echo "INSERT INTO ml_setting (k, v) VALUES ($(q "$1"), $(q "$2")) ON DUPLICATE KEY UPDATE v=VALUES(v)" | db; }

cmd_security() {
    local sub=list days=7 cat="" top=200 sev=""
    case ${1:-} in list|scan|update|autoblock|dns-block|summary|quarantine|release|quarantined|quarantine-auto|quarantine-server) sub=$1; shift ;; esac
    case $sub in
    quarantine)
        local t=${1:-}; [ -n "$t" ] || die "usage: radius-admin security quarantine IP|USER [reason ...]"; shift
        quarantine_add "$t" "${*:-quarantined by the admin}" 0; cmd_policy build >/dev/null; return ;;
    release)
        local t=${1:-}; [ -n "$t" ] || die "usage: radius-admin security release IP|USER"
        quarantine_release "$t" "${SUDO_USER:-admin}"; cmd_policy build >/dev/null; return ;;
    quarantined) cmd_quarantine "${1:-list}"; return ;;
    quarantine-auto)
        case ${1:-status} in
            on)  setting_set security_quarantine_auto 1; ok "Devices with a high virus alert are quarantined automatically (checked every 5 minutes)" ;;
            off) setting_set security_quarantine_auto 0; ok "Automatic quarantine off" ;;
            *)   echo "auto-quarantine: $( [ "$(setting_get security_quarantine_auto)" = 1 ] && echo on || echo off)" ;;
        esac; return ;;
    quarantine-server)
        local ip=${1:-}; valid_ip "$ip"; [[ $ip != */* ]] || die "one address"
        setting_set server_ip "$ip"; cmd_policy build >/dev/null
        ok "Quarantined devices are sent to the warning page on http://$ip:8081 (router auto-sync)"; return ;;
    scan)
        local out sql; sql=$(mktemp)
        if ! out=$(python3 -I /usr/local/lib/mikrotiklover/sentinel.py sql --cnf "$CONF_DIR/my.cnf" --db "$DB_NAME" 2>&1 >"$sql"); then
            rm -f "${sql:?}"; die "security scan failed: $out"
        fi
        db < "$sql"; rm -f "${sql:?}"
        ok "${out#security: }"; return ;;
    update)
        python3 -I /usr/local/lib/mikrotiklover/sentinel.py update
        threat_dns_reload; cmd_policy build >/dev/null; return ;;
    autoblock)
        case ${1:-status} in
            on)  setting_set security_autoblock 1; cmd_policy build >/dev/null
                 ok "Attackers (high severity, last 24 h) go to the router's ml-attackers list via auto-sync (needs mikrotik/security.rsc)" ;;
            off) setting_set security_autoblock 0; cmd_policy build >/dev/null; ok "Automatic blocking of attackers off" ;;
            *)   echo "autoblock: $( [ "$(setting_get security_autoblock)" = 1 ] && echo on || echo off)" ;;
        esac; return ;;
    dns-block)
        case ${1:-status} in
            on)  [ -s /var/lib/mikrotiklover/threat-hosts ] || python3 -I /usr/local/lib/mikrotiklover/sentinel.py update
                 echo "addn-hosts=/var/lib/mikrotiklover/threat-hosts" > "$SEC_BLOCK_CONF"; threat_dns_reload
                 ok "Malware / phishing / mining names answer 0.0.0.0 on the DNS logger (lookups still show up as virus alerts)" ;;
            off) rm -f "$SEC_BLOCK_CONF"; threat_dns_reload; ok "DNS blocking of threat names off" ;;
            *)   echo "dns-block: $( [ -f "$SEC_BLOCK_CONF" ] && echo on || echo off), $(wc -l < /var/lib/mikrotiklover/threat-hosts 2>/dev/null || echo 0) names" ;;
        esac; return ;;
    esac
    while [ $# -gt 0 ]; do
        case $1 in
            --days) days=${2:-}; valid_int "$days" days; shift 2 ;;
            --type|--category) cat=${2:-}; [[ $cat =~ ^(virus|attack|ddos)$ ]] || die "--type virus|attack|ddos"; shift 2 ;;
            --high) sev=high; shift ;;
            --top) top=${2:-}; valid_int "$top" top; shift 2 ;;
            *) die "usage: radius-admin security [--days N] [--type virus|attack|ddos] [--high] | summary | scan | update | autoblock on|off | dns-block on|off" ;;
        esac
    done
    local w="last_seen >= NOW() - INTERVAL $days DAY"
    [ -z "$cat" ] || w+=" AND category=$(q "$cat")"
    [ -z "$sev" ] || w+=" AND severity='high'"
    if [ "$sub" = summary ]; then
        echo "SELECT category, type, COUNT(*) AS events, SUM(hits) AS hits, COUNT(DISTINCT NULLIF(src_ip,'')) AS sources,
                     ELT(MAX(FIELD(severity,'low','medium','high')),'low','medium','high') AS worst, MAX(last_seen) AS last FROM ml_security_event WHERE $w GROUP BY category, type ORDER BY category, events DESC;" | dbt
        return
    fi
    echo "SELECT DATE_FORMAT(last_seen,'%m-%d %H:%i') AS last, UPPER(category) AS kind, severity AS sev, type,
                 COALESCE(NULLIF(src_ip,''),'-') AS source, NULLIF(username,'') AS user, COALESCE(NULLIF(dst_ip,''),'-') AS target,
                 hits, LEFT(detail, 70) AS detail
          FROM ml_security_event WHERE $w ORDER BY last_seen DESC LIMIT $top;" | dbt
}

# ---------------------------------------------------------------- website names (domains + subdomains)
cmd_domains() {
    local sub=list days=30 top=100 search=""
    case ${1:-} in tree|export) sub=$1; shift ;; esac
    if [ "$sub" = tree ]; then
        local base=${1:-}; [[ $base =~ ^[a-z0-9.-]{3,253}$ ]] || die "usage: radius-admin domains tree DOMAIN   (e.g. youtube.com)"
        echo "SELECT d.host, d.app, d.first_seen, d.last_seen, COALESCE(SUM(x.lookups),0) AS lookups, COALESCE(MAX(x.devices),0) AS max_devices_day, d.ips
              FROM ml_domain d LEFT JOIN ml_domain_day x ON x.host=d.host
              WHERE d.base=$(q "$base") OR d.host=$(q "$base") GROUP BY d.host ORDER BY lookups DESC LIMIT 1000;" | dbt
        return
    fi
    if [ "$sub" = export ]; then
        echo "SELECT host, base, app, first_seen, last_seen, ips FROM ml_domain ORDER BY base, host;" | dbh | tr '\t' ','
        return
    fi
    while [ $# -gt 0 ]; do
        case $1 in
            --days) days=${2:-}; valid_int "$days" days; shift 2 ;;
            --top) top=${2:-}; valid_int "$top" top; shift 2 ;;
            -*) die "usage: radius-admin domains [SEARCH] [--days N] | domains tree DOMAIN | domains export > file.csv" ;;
            *) search=$1; [[ $search =~ ^[a-z0-9.-]{1,100}$ ]] || die "Search: letters, digits, . -"; shift ;;
        esac
    done
    local w="d.last_seen >= NOW() - INTERVAL $days DAY"
    [ -z "$search" ] || w+=" AND d.host LIKE $(q "%$search%")"
    echo "SELECT d.base AS domain, MAX(NULLIF(d.app,'')) AS app, COUNT(*) AS subdomains, MIN(d.first_seen) AS first_seen, MAX(d.last_seen) AS last_seen
          FROM ml_domain d WHERE $w GROUP BY d.base ORDER BY COUNT(*) DESC, MAX(d.last_seen) DESC LIMIT $top;" | dbt
    echo "$(echo "SELECT COUNT(*) FROM ml_domain" | db) website names saved ($(echo "SELECT COUNT(DISTINCT base) FROM ml_domain" | db) domains) — radius-admin domains tree DOMAIN"
}

# ---------------------------------------------------------------- quarantine (infected devices)
quarantine_add() { # quarantine_add IP|USER REASON AUTO(0|1)
    local t=$1 reason=${2:-quarantined by the admin} auto=${3:-0} ip="" user="" prev=""
    reason=${reason//[^[:print:]]/}; reason=${reason:0:200}
    if [[ $t =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        valid_ip "$t"; ip=$t
        # an IP that belongs to a logged-in user: quarantine the user (follows the device to a new IP)
        user=$(echo "SELECT username FROM radacct WHERE framedipaddress=$(q "$ip") AND acctstoptime IS NULL ORDER BY acctstarttime DESC LIMIT 1" | db)
    else
        valid_name "$t" username; user_exists "$t" || die "No such user or IP '$t'"; user=$t
    fi
    [ "$(echo "SELECT COUNT(*) FROM ml_quarantine WHERE released_at IS NULL AND ((ip<>'' AND ip=$(q "$ip")) OR (username<>'' AND username=$(q "$user")))" | db)" = 0 ] \
        || { echo "$t is already in quarantine"; return 0; }
    if [ -n "$user" ]; then
        prev=$(echo "SELECT value FROM radreply WHERE username=$(q "$user") AND attribute='Mikrotik-Address-List' LIMIT 1" | db)
        [ "$prev" != ml-quarantine ] || prev=""
        echo "START TRANSACTION; DELETE FROM radreply WHERE username=$(q "$user") AND attribute='Mikrotik-Address-List';
              INSERT INTO radreply (username,attribute,op,value) VALUES ($(q "$user"),'Mikrotik-Address-List',':=','ml-quarantine'); COMMIT;" | db
    fi
    echo "INSERT INTO ml_quarantine (ip, username, prev_list, reason, auto) VALUES ($(q "$ip"), $(q "$user"), $(q "$prev"), $(q "$reason"), $auto);" | db
    [ -z "$user" ] || kick_user "$user" quiet          # the next login gets the quarantine list
    ok "Quarantined ${user:+user '$user' }${ip:+($ip) }— $reason"
}

quarantine_release() { # quarantine_release IP|USER BY
    local t=$1 by=${2:-admin} rows id ip user prev n=0
    [[ $t =~ ^[0-9.]+$ ]] && valid_ip "$t" || valid_name "$t" "user or IP"
    rows=$(echo "SELECT id, IFNULL(NULLIF(ip,''),'-'), IFNULL(NULLIF(username,''),'-'), IFNULL(NULLIF(prev_list,''),'-')
                 FROM ml_quarantine WHERE released_at IS NULL AND (ip=$(q "$t") OR username=$(q "$t"))" | db)
    [ -n "$rows" ] || die "$t is not in quarantine (radius-admin security quarantined)"
    while IFS=$'\t' read -r id ip user prev; do
        [ "$ip" != - ] || ip=""; [ "$user" != - ] || user=""; [ "$prev" != - ] || prev=""
        if [ -n "$user" ]; then
            echo "START TRANSACTION; DELETE FROM radreply WHERE username=$(q "$user") AND attribute='Mikrotik-Address-List' AND value='ml-quarantine';
                  $( [ -z "$prev" ] || echo "INSERT INTO radreply (username,attribute,op,value) VALUES ($(q "$user"),'Mikrotik-Address-List',':=',$(q "$prev"));")
                  COMMIT;" | db
            kick_user "$user" quiet </dev/null
        fi
        echo "UPDATE ml_quarantine SET released_at=NOW(), released_by=$(q "$by") WHERE id=$id" | db
        n=$((n + 1))
    done <<<"$rows"
    ok "Released $t ($n entry/entries) — internet works again${user:+ after the next login}"
}

quarantine_auto() { # every 5 minutes (enforce): devices with a HIGH virus alert in the last 2 hours
    [ "$(setting_get security_quarantine_auto)" = 1 ] || return 0
    local rows ip user types n=0
    rows=$(echo "SELECT e.src_ip, IFNULL(MAX(NULLIF(e.username,'')),'-'), LEFT(GROUP_CONCAT(DISTINCT e.type SEPARATOR ', '), 180)
                 FROM ml_security_event e
                 WHERE e.category='virus' AND e.severity='high' AND e.last_seen >= NOW() - INTERVAL 2 HOUR
                   AND e.src_ip REGEXP '^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+\$'
                   AND NOT EXISTS (SELECT 1 FROM ml_quarantine qa WHERE qa.released_at IS NULL AND (qa.ip=e.src_ip OR (e.username<>'' AND qa.username=e.username)))
                   AND NOT EXISTS (SELECT 1 FROM ml_quarantine qr WHERE qr.released_at >= NOW() - INTERVAL 1 DAY AND (qr.ip=e.src_ip OR (e.username<>'' AND qr.username=e.username)))
                 GROUP BY e.src_ip" | db 2>/dev/null || true)
    while IFS=$'\t' read -r ip user types; do
        [ -n "$ip" ] || continue
        if [ "$user" != - ] && user_exists "$user"; then quarantine_add "$user" "auto: $types" 1 >/dev/null </dev/null
        else quarantine_add "$ip" "auto: $types" 1 >/dev/null </dev/null; fi
        n=$((n + 1))
    done <<<"$rows"
    if [ "$n" -gt 0 ]; then cmd_policy build >/dev/null 2>&1 || true; echo "quarantined $n infected device(s) automatically"; fi
}

cmd_quarantine() {
    case ${1:-list} in
        list|"") echo "SELECT id, NULLIF(username,'') AS user, NULLIF(ip,'') AS ip, IF(auto,'auto','admin') AS by_, since, LEFT(reason,70) AS reason
                       FROM ml_quarantine WHERE released_at IS NULL ORDER BY since DESC;" | dbt
                 echo "auto-quarantine: $( [ "$(setting_get security_quarantine_auto)" = 1 ] && echo on || echo off)   warning page server: $(setting_get server_ip || true)" ;;
        history) echo "SELECT id, NULLIF(username,'') AS user, NULLIF(ip,'') AS ip, since, released_at, released_by, LEFT(reason,60) AS reason
                       FROM ml_quarantine ORDER BY id DESC LIMIT 100;" | dbt ;;
    esac
}

# ---------------------------------------------------------------- off-site backup (another server over SSH, or rclone: Google Drive ...)
OFFSITE_CONF=$CONF_DIR/offsite.conf
OFFSITE_KEY=$CONF_DIR/offsite_ed25519
OFFSITE_HOSTS=$CONF_DIR/offsite_known_hosts

offsite_load() { # sets OFFSITE_TYPE OFFSITE_TARGET OFFSITE_PORT OFFSITE_KEEP OFFSITE_PASS
    OFFSITE_TYPE="" OFFSITE_TARGET="" OFFSITE_PORT=22 OFFSITE_KEEP=30 OFFSITE_PASS=""
    [ -r "$OFFSITE_CONF" ] || return 1
    local k v
    while IFS='=' read -r k v; do
        case $k in OFFSITE_TYPE|OFFSITE_TARGET|OFFSITE_PORT|OFFSITE_KEEP|OFFSITE_PASS) printf -v "$k" '%s' "$v" ;; esac
    done < "$OFFSITE_CONF"
    [ -n "$OFFSITE_TYPE" ]
}
offsite_save() {
    umask 077
    printf 'OFFSITE_TYPE=%s\nOFFSITE_TARGET=%s\nOFFSITE_PORT=%s\nOFFSITE_KEEP=%s\nOFFSITE_PASS=%s\n' \
        "$OFFSITE_TYPE" "$OFFSITE_TARGET" "$OFFSITE_PORT" "$OFFSITE_KEEP" "$OFFSITE_PASS" > "$OFFSITE_CONF"
    chmod 600 "$OFFSITE_CONF"; umask 022
}
offsite_ssh() { # offsite_ssh COMMAND...  (on the backup server)
    ssh -i "$OFFSITE_KEY" -p "$OFFSITE_PORT" -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile="$OFFSITE_HOSTS" "${OFFSITE_TARGET%%:*}" "$@"
}
offsite_dir() { local d=${OFFSITE_TARGET#*:}; echo "${d:-.}"; }

offsite_put() { # offsite_put LOCALFILE NAME
    local f=$1 name=$2
    case $OFFSITE_TYPE in
        ssh)    scp -q -i "$OFFSITE_KEY" -P "$OFFSITE_PORT" -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new \
                    -o UserKnownHostsFile="$OFFSITE_HOSTS" "$f" "${OFFSITE_TARGET%%:*}:$(offsite_dir)/$name.part" \
                  && offsite_ssh "mv -f '$(offsite_dir)/$name.part' '$(offsite_dir)/$name'" ;;
        rclone) rclone copyto --retries 3 "$f" "$OFFSITE_TARGET/$name" ;;
    esac
}
offsite_list() { # newest first, file names only
    case $OFFSITE_TYPE in
        ssh)    offsite_ssh "ls -1t '$(offsite_dir)'" 2>/dev/null | grep -E '^mikrotiklover-.*\.tar\.gz\.enc$' || true ;;
        rclone) rclone lsf --format tp --separator '	' "$OFFSITE_TARGET" 2>/dev/null | sort -r | cut -f2 | grep -E '^mikrotiklover-.*\.tar\.gz\.enc$' || true ;;
    esac
}
offsite_prune() { # keep the newest OFFSITE_KEEP copies there
    local old
    offsite_list | tail -n +"$((OFFSITE_KEEP + 1))" | while IFS= read -r old; do
        [[ $old =~ ^mikrotiklover-[A-Za-z0-9.-]+\.tar\.gz\.enc$ ]] || continue
        case $OFFSITE_TYPE in
            ssh)    offsite_ssh "rm -f '$(offsite_dir)/$old'" </dev/null ;;
            rclone) rclone deletefile "$OFFSITE_TARGET/$old" </dev/null ;;
        esac
    done
}

offsite_send() { # offsite_send [LOCAL BACKUP]  -> encrypted copy off this server
    offsite_load || die "Off-site backup is not set up (radius-admin backup offsite ssh|rclone ...)"
    local f=${1:-} name tmp
    [ -n "$f" ] || f=$(ls -1t "$BACKUP_DIR"/mikrotiklover-*.tar.gz* 2>/dev/null | head -1)
    [ -f "$f" ] || { [ -f "$BACKUP_DIR/$f" ] && f="$BACKUP_DIR/$f"; } || true
    [ -f "$f" ] || die "No backup to send (radius-admin backup)"
    name=$(basename "$f")
    if [[ $name == *.enc ]]; then
        # an encrypted backup with its own password is sent as it is
        offsite_put "$f" "$name" || die "upload failed"
    else
        tmp=$(mktemp)
        printf '%s' "$OFFSITE_PASS" | openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass stdin -in "$f" -out "$tmp" \
            || { rm -f "${tmp:?}"; die "encryption failed"; }
        name+=".enc"
        offsite_put "$tmp" "$name" || { rm -f "${tmp:?}"; die "upload to $OFFSITE_TARGET failed"; }
        rm -f "${tmp:?}"
    fi
    offsite_prune
    ok "Off-site: $name -> $OFFSITE_TARGET ($(offsite_list | wc -l) copies there, newest $OFFSITE_KEEP kept)"
}

cmd_offsite() {
    local sub=${1:-status}; shift || true
    case $sub in
    ssh)
        local target=${1:-} port=22; shift || true
        [ "${1:-}" = --port ] && { port=${2:-}; valid_int "$port" port; }
        [[ $target =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+:[A-Za-z0-9._/~-]*$ ]] || die "usage: radius-admin backup offsite ssh USER@HOST:/folder [--port 22]"
        [ -f "$OFFSITE_KEY" ] || ssh-keygen -q -t ed25519 -N "" -C "mikrotiklover-backup@$(hostname -s)" -f "$OFFSITE_KEY"
        offsite_load || true
        OFFSITE_TYPE=ssh OFFSITE_TARGET=$target OFFSITE_PORT=$port
        [ -n "$OFFSITE_PASS" ] || OFFSITE_PASS=$(gen_pass 24)
        offsite_save
        echo "Public key — add this line to ~/.ssh/authorized_keys of '${target%%@*}' on ${target#*@} (once):"
        echo; cat "$OFFSITE_KEY.pub"; echo
        if offsite_ssh "mkdir -p '$(offsite_dir)' && test -w '$(offsite_dir)'" </dev/null 2>/dev/null; then
            ok "Connected to ${target%%:*}; nightly backups go to $(offsite_dir) (encrypted)"
        else
            echo "! Not connected yet — add the key above, then run: radius-admin backup offsite test"
        fi
        echo "Backup password (needed to restore from there — write it down): $OFFSITE_PASS" ;;
    rclone)
        local target=${1:-}
        command -v rclone >/dev/null || die "rclone is not installed (apt install rclone), then: rclone config"
        local rre='^[A-Za-z0-9_-]+:[A-Za-z0-9._/ -]*$'
        [[ $target =~ $rre ]] || die "usage: radius-admin backup offsite rclone REMOTE:folder   (make the remote first: rclone config)"
        rclone listremotes 2>/dev/null | grep -qx "${target%%:*}:" || die "No rclone remote '${target%%:*}' — create it first: rclone config (Google Drive, Dropbox, OneDrive, S3 ...)"
        offsite_load || true
        OFFSITE_TYPE=rclone OFFSITE_TARGET=$target OFFSITE_PORT=22
        [ -n "$OFFSITE_PASS" ] || OFFSITE_PASS=$(gen_pass 24)
        offsite_save
        rclone mkdir "$target" 2>/dev/null || true
        ok "Nightly backups go to $target (encrypted)"
        echo "Backup password (needed to restore from there — write it down): $OFFSITE_PASS" ;;
    keep)
        local n=${1:-}; valid_int "$n" keep; [ "$n" -ge 1 ] || die "keep at least 1"
        offsite_load || die "Off-site backup is not set up"; OFFSITE_KEEP=$n; offsite_save; ok "Off-site: newest $n copies kept" ;;
    off)
        rm -f "${OFFSITE_CONF:?}"; ok "Off-site backup off (the copies already there are kept)" ;;
    test)
        offsite_load || die "Off-site backup is not set up"
        local t; t=$(mktemp); echo "MikrotikLover off-site test $(date)" > "$t"
        offsite_put "$t" "mikrotiklover-test.txt" && rm -f "${t:?}" || { rm -f "${t:?}"; die "Cannot write to $OFFSITE_TARGET"; }
        case $OFFSITE_TYPE in ssh) offsite_ssh "rm -f '$(offsite_dir)/mikrotiklover-test.txt'" ;; rclone) rclone deletefile "$OFFSITE_TARGET/mikrotiklover-test.txt" ;; esac
        ok "Off-site works: $OFFSITE_TYPE $OFFSITE_TARGET" ;;
    send)
        local o
        if o=$(offsite_send "${1:-}" 2>&1); then
            update_stamp "Off-site backup" "ok: $(tail -1 <<<"$o" | sed 's/\x1b\[[0-9;]*m//g' | cut -c1-120)"; echo "$o"
        else
            update_stamp "Off-site backup" "failed: $(tail -1 <<<"$o" | cut -c1-120)"; echo "$o" >&2; return 1
        fi ;;
    list)
        offsite_load || die "Off-site backup is not set up"
        offsite_list ;;
    fetch)
        offsite_load || die "Off-site backup is not set up"
        local name=${1:-}; [ -n "$name" ] || name=$(offsite_list | head -1)
        [[ $name =~ ^mikrotiklover-[A-Za-z0-9.-]+\.tar\.gz\.enc$ ]] || die "usage: radius-admin backup offsite fetch [NAME]   (radius-admin backup offsite list)"
        backup_perms
        case $OFFSITE_TYPE in
            ssh)    scp -q -i "$OFFSITE_KEY" -P "$OFFSITE_PORT" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$OFFSITE_HOSTS" \
                        "${OFFSITE_TARGET%%:*}:$(offsite_dir)/$name" "$BACKUP_DIR/$name" ;;
            rclone) rclone copyto "$OFFSITE_TARGET/$name" "$BACKUP_DIR/$name" ;;
        esac || die "download failed"
        chmod 640 "$BACKUP_DIR/$name"
        ok "Downloaded $BACKUP_DIR/$name — restore: radius-admin restore $name   (password: radius-admin backup offsite password)" ;;
    password)
        offsite_load || die "Off-site backup is not set up"; echo "$OFFSITE_PASS" ;;
    status)
        if offsite_load; then
            echo "type=$OFFSITE_TYPE"; echo "target=$OFFSITE_TARGET"; echo "port=$OFFSITE_PORT"; echo "keep=$OFFSITE_KEEP"
            [ "$OFFSITE_TYPE" != ssh ] || echo "public_key=$(cat "$OFFSITE_KEY.pub" 2>/dev/null)"
            grep "^Off-site backup	" /var/lib/mikrotiklover/updates.txt 2>/dev/null | cut -f2,3 | sed 's/^/last=/' || true
        else
            echo "type=off"
        fi ;;
    *) die "usage: radius-admin backup offsite ssh USER@HOST:/dir [--port N] | rclone REMOTE:dir | test | send [FILE] | list | fetch [NAME] | keep N | password | status | off" ;;
    esac
}

# ---------------------------------------------------------------- alerts (Telegram / WhatsApp / email)
ALERTS_PY=/usr/local/lib/mikrotiklover/alerts.py
alerts_py() { ML_BRAND="$(setting_get brand 2>/dev/null || true)" python3 -I "$ALERTS_PY" --cnf "$CONF_DIR/my.cnf" --db "$DB_NAME" "$@"; }

cmd_alerts() {
    local sub=${1:-status}; shift || true
    case $sub in
    status) alerts_py status "$@" ;;
    telegram)
        local token=${1:-} chat=${2:-}
        [ -n "$token" ] || die "usage: radius-admin alerts telegram BOT_TOKEN [CHAT_ID]   (make a bot with @BotFather)"
        printf 'TELEGRAM_TOKEN=%s\nTELEGRAM_CHAT=%s\n' "$token" "$chat" | alerts_py set >/dev/null
        if [ -z "$chat" ]; then
            local chats; chats=$(alerts_py telegram-chats) || die "$chats"
            if [ "$(grep -c $'\t' <<<"$chats")" = 1 ]; then
                chat=$(cut -f1 <<<"$chats"); printf 'TELEGRAM_CHAT=%s\n' "$chat" | alerts_py set >/dev/null
                ok "Telegram: chat $(cut -f2- <<<"$chats") ($chat) — test: radius-admin alerts test telegram"
            else
                echo "$chats"; echo "Then: radius-admin alerts telegram TOKEN CHAT_ID"
            fi
        else
            ok "Telegram on (chat $chat) — test: radius-admin alerts test telegram"
        fi ;;
    whatsapp)
        [ $# -eq 2 ] || die "usage: radius-admin alerts whatsapp PHONE APIKEY   (free key: send 'I allow callmebot to send me messages' to CallMeBot on WhatsApp)"
        printf 'WHATSAPP_PHONE=%s\nWHATSAPP_APIKEY=%s\n' "$1" "$2" | alerts_py set >/dev/null && ok "WhatsApp on ($1) — test: radius-admin alerts test whatsapp" ;;
    email)
        local to=${1:-} host=${2:-} user="" from="" tls=starttls pass=""; shift 2 || true
        [ -n "$to" ] && [ -n "$host" ] || die "usage: radius-admin alerts email TO SMTP_HOST[:PORT] [--user USER] [--from ADDR] [--tls starttls|ssl|none]   (password asked / from stdin)"
        while [ $# -gt 0 ]; do case $1 in
            --user) user=${2:-}; shift 2 ;; --from) from=${2:-}; shift 2 ;; --tls) tls=${2:-}; shift 2 ;;
            *) die "Unknown option $1" ;; esac; done
        local port=${host##*:}; [ "$port" != "$host" ] || port=""; host=${host%%:*}
        if [ -n "$user" ]; then
            if [ -t 0 ]; then read -r -s -p "SMTP password for $user: " pass; echo >&2; else read -r pass || true; fi
            [ -n "$pass" ] || die "SMTP password is empty"
        fi
        printf 'EMAIL_TO=%s\nSMTP_HOST=%s\nSMTP_PORT=%s\nSMTP_USER=%s\nSMTP_PASS=%s\nEMAIL_FROM=%s\nSMTP_TLS=%s\n' \
            "$to" "$host" "$port" "$user" "$pass" "$from" "$tls" | alerts_py set >/dev/null && ok "Email on ($to via $host) — test: radius-admin alerts test email" ;;
    off)
        case ${1:-} in
            telegram) printf 'TELEGRAM_TOKEN=\nTELEGRAM_CHAT=\n' ;;
            whatsapp) printf 'WHATSAPP_PHONE=\nWHATSAPP_APIKEY=\n' ;;
            email)    printf 'EMAIL_TO=\nSMTP_HOST=\nSMTP_PORT=\nSMTP_USER=\nSMTP_PASS=\nEMAIL_FROM=\nSMTP_TLS=\n' ;;
            *) die "usage: radius-admin alerts off telegram|whatsapp|email" ;;
        esac | alerts_py set >/dev/null && ok "Alerts: ${1} off" ;;
    events)
        local cur; cur=$(alerts_py status --json | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)["events"]))')
        if [ $# -eq 0 ]; then echo "on: ${cur//,/ }"; echo "all: security quarantine router service jobs disk expiring summary"; return; fi
        local ev=$1 state=${2:-}
        case $state in
            on)  cur="$cur,$ev" ;;
            off) cur=$(tr ',' '\n' <<<"$cur" | grep -vx "$ev" | paste -sd, -) ;;
            *) die "usage: radius-admin alerts events [EVENT on|off]" ;;
        esac
        printf 'EVENTS=%s\n' "$(tr ',' '\n' <<<"$cur" | grep -v '^$' | sort -u | paste -sd, -)" | alerts_py set >/dev/null && ok "Alert '$ev' $state" ;;
    summary-hour)
        printf 'SUMMARY_HOUR=%s\n' "${1:-}" | alerts_py set >/dev/null && ok "Daily summary at ${1}:00" ;;
    set|test|send|check|summary|log|telegram-chats) alerts_py "$sub" "$@" ;;
    *) die "usage: radius-admin alerts status | telegram TOKEN [CHAT] | whatsapp PHONE KEY | email TO HOST[:PORT] [...] | off CHANNEL | events [EV on|off] | summary-hour H | test [CHANNEL] | send TITLE [TEXT] | check | summary | log [N]" ;;
    esac
}

cmd_sales() {
    local days=${1:-30}; valid_int "$days" days
    echo "SELECT DATE(at) AS day, COUNT(*) AS sales, SUM(kind='voucher') AS vouchers, SUM(kind='renew') AS renewals,
                 SUM(kind='new') AS new_plans, SUM(amount) AS amount
          FROM ml_sale WHERE at >= CURDATE() - INTERVAL $days DAY GROUP BY DATE(at) ORDER BY day DESC;" | dbt
    echo "Total: $(echo "SELECT COALESCE(SUM(amount),0) FROM ml_sale WHERE at >= CURDATE() - INTERVAL $days DAY" | db) (last $days days)"
}

cmd_usage() {
    local u=${1:-}; valid_name "$u" username
    user_exists "$u" || [ "$(echo "SELECT COUNT(*) FROM radacct WHERE username=$(q "$u")" | db)" != 0 ] || die "No such user '$u'"
    echo "SELECT DATE(acctstarttime) AS day, COUNT(*) AS sessions,
                 SEC_TO_TIME(SUM(acctsessiontime)) AS online,
                 ROUND(SUM(acctinputoctets)/1048576,1) AS MB_up, ROUND(SUM(acctoutputoctets)/1048576,1) AS MB_down
          FROM radacct WHERE username=$(q "$u") AND acctstarttime >= NOW() - INTERVAL 30 DAY
          GROUP BY DATE(acctstarttime) ORDER BY day DESC;" | dbt
}

cmd_test() {
    local u=${1:-}; [ -n "$u" ] || die "usage: radius-admin test USER [PASS] [--peap]"
    shift; local p="" peap=0
    while [ $# -gt 0 ]; do case $1 in --peap) peap=1 ;; *) p=$1 ;; esac; shift; done
    if [ -z "$p" ]; then read -r -s -p "Password for $u: " p; echo >&2; fi
    if [ "$peap" = 1 ]; then
        command -v eapol_test >/dev/null || die "eapol_test not installed (apt install eapoltest)"
        local cfg log; cfg=$(mktemp); log=$(mktemp); trap 'rm -f "$cfg" "$log"' RETURN
        cat > "$cfg" <<EOF
network={
    key_mgmt=WPA-EAP
    eap=PEAP
    identity="$u"
    anonymous_identity="anonymous"
    password="$p"
    phase2="auth=MSCHAPV2"
    ca_cert="/etc/freeradius/3.0/certs/mikrotiklover/ca.pem"
    domain_match="$RADIUS_DOMAIN"
}
EOF
        if eapol_test -c "$cfg" -a 127.0.0.1 -s "$LOCAL_SECRET" -t 10 >"$log" 2>&1; then
            ok "PEAP-MSCHAPv2 login OK for '$u' (Wi-Fi clients will work)"
        else
            tail -5 "$log"; die "PEAP login FAILED for '$u'"
        fi
    else
        local out; out=$(radtest -t mschap "$u" "$p" 127.0.0.1 0 "$LOCAL_SECRET" 2>&1 || true)
        if grep -q 'Received Access-Accept' <<<"$out"; then
            ok "MSCHAPv2 login OK for '$u'"
            # the server's answer only (radtest also echoes the request, password included)
            sed -n '/Received Access-Accept/,$p' <<<"$out" | grep -E '^\s+[A-Za-z0-9-]+ = ' | grep -vE '^\s+(MS-|Message-Authenticator)' || true
        else
            echo "$out" | tail -4; die "Login FAILED for '$u'"
        fi
    fi
}

usage() {
    cat <<'EOF'
radius-admin — MikrotikLover RADIUS management

Users
  user add NAME [-p PASS] [-g GROUP] [--nt-hash]   create user (no -p: prompt / random)
  user passwd NAME [-p PASS] [--nt-hash]           change password
  user group NAME GROUP|-                          set or remove the user's group
  user disable|enable NAME                         block / unblock
  user del NAME                                    delete
  user list | user show NAME

Hotspot business (plans, vouchers, expiry, data quota, daily time)
  plan add NAME --price 500 --validity 30d --quota 10G --period monthly --rate 5M/5M --devices 1 [--daily-time 2h]
  plan list | plan show NAME | plan del NAME [--force]
  voucher create PLAN COUNT [--prefix WF] [--pin] [--note TEXT]    printable cards in the dashboard
  voucher list | voucher show BATCH | voucher csv BATCH | voucher del BATCH   (del removes unused only)
  user plan NAME PLAN|- [--free]       put a user on a plan (sale booked unless --free)
  user renew NAME [--free]             extend by the plan validity, reset the data counter
  user expiry NAME 'YYYY-MM-DD HH:MM'|-   fixed expiry date
  user quota NAME 20G|-                per-user data quota
  user status NAME                     plan, expiry, quota and what RADIUS will answer
  user ip NAME 10.20.0.5|-             static IP (PPPoE)          group add NAME --pool POOL   (PPPoE IP pool)
  plan add NAME ... --fup 1M/1M        after the quota: slower instead of cut off (FUP)
  enforce [-v]                         cut expired / slow FUP sessions now (cron runs it every 5 min)
  sales [DAYS]                         money in per day

Ports & protocols (traffic collector)
  ports                                 top ports today: protocol, port, service, OUT/IN/P2P, data, devices, apps
  ports --by app [--app youtube.com]    which ports/protocols each app uses
  ports --by device [--ip IP | -u USER] ports per device
  ports --by in                         connections started FROM the internet to LAN devices
  ports --by profile [--app SITE]       saved long-term port profile of every app

Apps & website names (built every hour from the DNS log)
  apps [--days 7] [-u USER] [--ip IP] [--category C]
                                        every app used on the network (auto list): devices, users, data, first/last seen
  apps new [DAYS]                       apps first seen in the last DAYS (default 7)
  apps users APP                        which devices/users use an app (name or site, e.g. "PUBG Mobile")
  apps update                           rebuild the list now (cron does it every hour)
  domains [SEARCH] [--days 30]          every website name seen (domains + subdomains), saved for good
  domains tree DOMAIN                   all subdomains of a domain: first/last seen, lookups, IPs
  domains export > names.csv            everything as CSV

Blocking policies + router auto-sync (dashboard → Blocking)
  policy list | show NAME               web-filter policies (who is in them, what they block)
  policy set NAME < file                create / change a policy (directives: webfilter/policies/README.txt)
  policy del NAME                       delete an unused policy
  policy build                          rebuild the router rules (+ VPN server list); cron does it every hour
  policy sync                           URL + key for the router auto-sync script (dashboard → Blocking)
  policy new-key                        new router sync key (then re-import the script on every router)
  blocked [--days 1] [-u USER] [--policy NAME] [--summary]
                                        blocking logs: which policy blocked which user, what, site name

VPN & proxy watch
  vpn [--days 7] [-u USER]              VPN attempts: who, when, which VPN, blocked or not
  vpn users | servers | domains         per user / the automatic VPN server and name lists
  vpn scan                              read the DNS + router logs now (cron: every hour)
  vpn update                            add the public VPN-provider + Tor lists (then weekly)
  vpn ignore NAME|IP                    not a VPN (e.g. your office VPN): never list or block it

Security detective (virus, hacker attacks, DDoS)
  security [--days 7] [--type virus|attack|ddos] [--high]
                                        security detective: infected devices, hacker attacks, DDoS (by type)
  security summary                      counts per type
  security scan | update                read the logs now (hourly) | download threat lists (weekly)
  security autoblock on|off             attackers -> router list ml-attackers (auto-sync, mikrotik/security.rsc)
  security dns-block on|off             malware / phishing / mining names answer 0.0.0.0 (DNS logger)
  security quarantine IP|USER [reason] infected device: no internet, only a warning page (router auto-sync)
  security release IP|USER              end the quarantine
  security quarantined [history]        who is in quarantine
  security quarantine-auto on|off       quarantine devices with a HIGH virus alert automatically (every 5 min)
  security quarantine-server IP         this server's IP as the routers see it (warning page on port 8081)

Backup, restore, automatic updates
  backup [--encrypt] [--with-logs]      complete backup: database, settings, certificates, FreeRADIUS, policies
  backups                               list backups (/var/backups/mikrotiklover; every night, 14 kept)
  backup offsite ssh USER@HOST:/dir     nightly ENCRYPTED copy to another server (prints the SSH key to add there)
  backup offsite rclone REMOTE:dir      ... or to Google Drive / Dropbox / OneDrive / S3 (after: rclone config)
  backup offsite test | send | list     check / send the newest backup now / what is there
  backup offsite fetch [NAME]           download from there, then: restore NAME (password: backup offsite password)
  backup offsite keep N | status | off
  restore FILE [--yes]                  restore everything from a backup (a safety copy is made first)
  update                                all automatic updates now (weekly cron): app catalog, IP owners,
                                        new app names, threat lists, VPN lists, router rules

Alerts (Telegram / WhatsApp / email)
  alerts                                what is on: channels, events, last check
  alerts telegram BOT_TOKEN [CHAT_ID]   Telegram bot (from @BotFather); no chat id: found after you press Start
  alerts whatsapp PHONE APIKEY          WhatsApp via CallMeBot (free key)
  alerts email TO HOST[:PORT] [--user U] [--from A] [--tls starttls|ssl|none]
  alerts off telegram|whatsapp|email
  alerts events [EVENT on|off]          security quarantine router service jobs disk expiring summary
  alerts summary-hour H                 daily summary time (default 21)
  alerts test [CHANNEL] | send TITLE [TEXT] | summary | log [N]
  alerts check                          look for problems and send them (cron, every 5 minutes)

CDN detective
  cdn HOSTNAME|IP [--json]             which app/site is behind it (name, DNS evidence, IP owner, context)
  cdn unknown [DAYS]                   heaviest traffic that has no site name yet
  cdn update                           refresh the IP owner lists (weekly by cron)
  cdn apps                             every app with its domain count (built-in + learned)
  cdn learned [APP]                    domains learned automatically (hourly by cron)
  cdn learn                            learn now from the DNS log
  cdn reject DOMAIN | unreject DOMAIN  wrongly learned -> remove and never learn again
  cdn rsc 'APP'                        RouterOS script blocking all domains of an app
  cdn discovered                       NEW apps found automatically (name + category guessed)
  cdn app-rename ID 'Name' [category] | app-merge ID 'Known App' | app-drop ID

Groups (speed limit, VLAN, timeouts, devices per user)
  group add NAME [--rate 10M/10M] [--vlan 20] [--session-timeout 86400]
                 [--idle-timeout 900] [--max-sessions 2]
                 [--address-list web-filter-exempt]   (hotspot: user's IP joins this list)
  group del NAME | group show NAME | group list

Policies / blocking (per user, group, IP range — see webfilter/policies/)
  user policy NAME POLICY|-            this user only (overrides group); kicks to apply
  group add NAME --policy POLICY       whole group
  kick USER|MAC                        disconnect now (re-login applies changes)
  blocked [N] [-u USER]                who tried to open blocked sites (router log, with the policy)

Visited sites / live log (needs: radius-admin dnslog on ROUTER_IP + mikrotik/dns-logging.rsc)
  sites [-u USER] [--ip IP] [--days 7] [--top 30]   most visited sites
  history -u USER [--days 1] [N]                     what a user opened, in order
  live [-u USER] [--ip IP]                            live log: visits + blocks (Ctrl+C)
  dnslog on ROUTER_IP | off | status                  DNS query logger on this server

Data usage — download/upload per website, IP, user (needs: traffic collector on + mikrotik/traffic-flow.rsc)
  traffic                              today, per website (download / upload / total)
  traffic --by ip|user|day|hour        per client IP, per user, per day, per hour
  traffic -u ali --days 30             one user, per website
  traffic --ip 192.168.88.23           one IP, per website
  traffic --site youtube.com --by user who used YouTube, how much
  traffic now                          last minute, live (Mbps)
  traffic collector on|off|status

Web dashboard (https://SERVER:8443)
  web list | web passwd NAME | web role NAME admin|viewer | web del NAME
  IP range / single device: on the router — see README "Policies"

MAC authentication (devices without username/password: printers, CCTV, TVs, POS)
  mac add MAC [-g GROUP] [-d "Reception printer"]   any format: aa:bb:.., AABB.CCDD.EEFF
  mac del|disable|enable MAC | mac group MAC GROUP|- | mac list

Routers (MikroTik = NAS)
  nas add IP[/PREFIX] [SECRET] [NAME]   (no SECRET: random one is generated)
  nas del IP | nas list

Monitoring
  online               users connected now
  log [N]              last N login attempts (accept/reject)
  usage USER           daily usage, last 30 days
  test USER [PASS] [--peap]   test a login against this server
  restart | status

--nt-hash stores an NT hash instead of the password. It works for WPA2-Enterprise
(PEAP/TTLS-MSCHAPv2) but NOT for hotspot CHAP logins.
EOF
}

case ${1:-help} in
    user)    shift; cmd_user "$@" ;;
    group)   shift; cmd_group "$@" ;;
    nas)     shift; cmd_nas "$@" ;;
    mac)     shift; cmd_mac "$@" ;;
    kick)    shift; cmd_kick "$@" ;;
    blocked) shift; cmd_blocked "$@" ;;
    sites)   shift; cmd_sites "$@" ;;
    history) shift; cmd_history "$@" ;;
    live)    shift; cmd_live "$@" ;;
    dnslog)  shift; cmd_dnslog "$@" ;;
    traffic) shift; cmd_traffic "$@" ;;
    web)     shift; cmd_web "$@" ;;
    plan)    shift; cmd_plan "$@" ;;
    voucher) shift; cmd_voucher "$@" ;;
    sales)   shift; cmd_sales "$@" ;;
    enforce) shift; cmd_enforce "$@" ;;
    cdn)     shift; cmd_cdn "$@" ;;
    ports)   shift; cmd_ports "$@" ;;
    apps)    shift; cmd_apps "$@" ;;
    policy)  shift; cmd_policy "$@" ;;
    vpn)     shift; cmd_vpn "$@" ;;
    security) shift; cmd_security "$@" ;;
    domains) shift; cmd_domains "$@" ;;
    backup)  shift; cmd_backup "$@" ;;
    alerts)  shift; cmd_alerts "$@" ;;
    backups) cmd_backups ;;
    restore) shift; cmd_restore "$@" ;;
    update)  cmd_update ;;
    hourly)  cmd_hourly ;;
    syslog-sync) syslog_sync ;;
    online)  cmd_online ;;
    log)     shift; cmd_log "$@" ;;
    usage)   shift; cmd_usage "$@" ;;
    test)    shift; cmd_test "$@" ;;
    restart) restart_radius; ok "FreeRADIUS restarted" ;;
    status)  svc status freeradius || true ;;
    help|-h|--help) usage ;;
    *) echo "ERROR: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
