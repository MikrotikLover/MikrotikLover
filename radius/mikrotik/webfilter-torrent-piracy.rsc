# MikrotikLover web filter — category: torrent-piracy
# Torrent sites, clients and trackers
# Generated by radius/webfilter/build.sh from webfilter/categories/torrent-piracy.txt — edit that file, not this one.
# Needs webfilter-base.rsc. Remove the category again with:
#   /ip dns static remove [find comment="webfilter:torrent-piracy"]

/ip dns static
remove [find comment="webfilter:torrent-piracy"]
:do { /ip dns static add name=thepiratebay.org type=NXDOMAIN match-subdomain=yes comment="webfilter:torrent-piracy" } on-error={}
