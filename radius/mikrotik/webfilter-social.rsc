# MikrotikLover web filter — category: social
# Social media (subdomains are blocked too)
# Generated by radius/webfilter/build.sh from webfilter/categories/social.txt — edit that file, not this one.
# Needs webfilter-base.rsc. Remove the category again with:
#   /ip dns static remove [find comment="webfilter:social"]

/ip dns static
remove [find comment="webfilter:social"]
add name=facebook.com type=NXDOMAIN match-subdomain=yes comment="webfilter:social"
add name=fb.com type=NXDOMAIN match-subdomain=yes comment="webfilter:social"
add name=fb.me type=NXDOMAIN match-subdomain=yes comment="webfilter:social"
