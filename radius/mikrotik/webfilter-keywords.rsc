# MikrotikLover web filter — KEYWORDS in website names (needs webfilter-base.rsc)
# Generated by radius/webfilter/build.sh from webfilter/keywords.txt — edit that file, not this one.
#
# Layer 1: DNS — any domain containing a keyword gets NXDOMAIN.
# Layer 2: firewall — HTTPS connections whose TLS server name (SNI) contains a keyword are
#          reset, even if the device found the IP some other way.
# Devices in address list web-filter-exempt are not filtered by layer 2 (layer 1 is skipped
# for them by webfilter-base.rsc, which sends their DNS to an unfiltered server).

/ip dns static
remove [find comment="webfilter:keywords"]
add regexp=".*(porn|xxx|xnxx|xvideos|xhamster|redtube|youporn|brazzers|hentai|nsfw|sexvideo|sexmovie|sexcam|freesex|hotsex|livesex).*" type=NXDOMAIN comment="webfilter:keywords"
add regexp="(^|.*[.-])(sex|nude|xnx).*" type=NXDOMAIN comment="webfilter:keywords"

/ip firewall filter
remove [find comment="webfilter:keywords"]
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*porn*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*xxx*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*xnxx*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*xvideos*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*xhamster*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*redtube*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*youporn*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*brazzers*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*hentai*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*nsfw*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*sexvideo*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*sexmovie*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*sexcam*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*freesex*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*hotsex*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*livesex*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="sex*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*.sex*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*-sex*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="nude*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*.nude*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*-nude*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="xnx*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*.xnx*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
add chain=forward in-interface-list=LAN src-address-list=!web-filter-exempt protocol=tcp dst-port=443 tls-host="*-xnx*" action=reject reject-with=tcp-reset comment="webfilter:keywords"
# above every other rule (destination=0 is not safe in a script: it stops the import when only these rules are there)
:do { :local o [/ip firewall filter find where !(comment="webfilter:keywords")]; :if ([:len $o] > 0) do={ /ip firewall filter move [/ip firewall filter find comment="webfilter:keywords"] destination=[:pick $o 0] } }
