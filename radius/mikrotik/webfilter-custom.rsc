# MikrotikLover web filter — category: custom
# Your own blocked websites — one domain per line, subdomains are blocked too.
# Generated by radius/webfilter/build.sh from webfilter/categories/custom.txt — edit that file, not this one.
# Needs webfilter-base.rsc. Remove the category again with:
#   /ip dns static remove [find comment="webfilter:custom"]

/ip dns static
remove [find comment="webfilter:custom"]
