# MikrotikLover web filter — POLICIES per single user / group / IP range (needs webfilter-base.rsc)
# Generated by radius/webfilter/build.sh from the policy files — edit those (or the dashboard → Blocking), not this file.
#
# A device is in a policy when its IP is in address list "policy-<name>":
#   single device (MAC) : /ip dhcp-server lease set [find mac-address=AA:BB:CC:DD:EE:FF] address-lists=policy-students
#   single IP / range   : /ip firewall address-list add list=policy-students address=192.168.88.100-192.168.88.150
#   subnet / VLAN       : /ip firewall address-list add list=policy-staff address=192.168.20.0/24
#   hotspot user        : radius-admin user policy ali students
#   hotspot group       : radius-admin group add class-9 --policy students
# Policies: guests night-off no-internet no-tiktok-pubg no-video-day no-video no-vpn staff students whatsapp-only 
# Checks the HTTPS site name (SNI), so it works per device even when DNS answers are cached.

/ip firewall filter
remove [find comment~"^wfpolicy:"]
remove [find comment~"^wfchain:"]
/ip firewall nat
remove [find comment~"^wfpolicy:"]

# ---- allow-only profile whatsapp (address lists)
/ip firewall address-list
remove [find comment~"^wfchain:ao-whatsapp"]
add list=whatsapp-servers address=31.13.24.0/21 comment="wfchain:ao-whatsapp"
add list=whatsapp-servers address=31.13.64.0/18 comment="wfchain:ao-whatsapp"
