# MikrotikLover web filter — category: windows-update
# Windows Update: the update service, its downloads and Delivery Optimization (peer downloads).
# Generated by radius/webfilter/build.sh from webfilter/categories/windows-update.txt — edit that file, not this one.
# Needs webfilter-base.rsc. Remove the category again with:
#   /ip dns static remove [find comment="webfilter:windows-update"]

/ip dns static
remove [find comment="webfilter:windows-update"]
:do { /ip dns static add name=windowsupdate.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=windowsupdate.microsoft.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=update.microsoft.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=delivery.mp.microsoft.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=do.dsp.mp.microsoft.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=dsp.mp.microsoft.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=emdl.ws.microsoft.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=wustat.windows.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=ntservicepack.microsoft.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
:do { /ip dns static add name=download.windowsupdate.com type=NXDOMAIN match-subdomain=yes comment="webfilter:windows-update" } on-error={}
