# MikrotikLover web filter — category: vpn-proxy
# VPN and web-proxy websites (stops downloads/sign-ups; installed VPN apps need firewall rules)
# Generated by radius/webfilter/build.sh from webfilter/categories/vpn-proxy.txt — edit that file, not this one.
# Needs webfilter-base.rsc. Remove the category again with:
#   /ip dns static remove [find comment="webfilter:vpn-proxy"]

/ip dns static
remove [find comment="webfilter:vpn-proxy"]
:do { /ip dns static add name=nordvpn.com type=NXDOMAIN match-subdomain=yes comment="webfilter:vpn-proxy" } on-error={}
