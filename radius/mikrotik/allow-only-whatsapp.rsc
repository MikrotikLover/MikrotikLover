# Phone/PC support: Wi-Fi "internet available" checks (HTTP only) and push notifications
remove [find comment="allowonly:support"]
add list=allowonly-checks address=connectivitycheck.gstatic.com comment="allowonly:support"
add list=allowonly-checks address=connectivitycheck.android.com comment="allowonly:support"
add list=allowonly-checks address=clients3.google.com comment="allowonly:support"
add list=allowonly-checks address=captive.apple.com comment="allowonly:support"
add list=allowonly-checks address=www.msftconnecttest.com comment="allowonly:support"
add list=allowonly-gpush address=mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt1-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt2-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt3-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt4-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt5-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt6-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt7-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt8-mtalk.google.com comment="allowonly:support"

/ip firewall filter
remove [find comment~"^allowonly:whatsapp"]
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*facebook*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny facebook"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*fbcdn*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny fbcdn"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*fbsbx*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny fbsbx"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*instagram*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny instagram"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*messenger*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny messenger"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*threads*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny threads"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*oculus*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny oculus"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*meta.com*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny meta.com"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*meta.ai*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny meta.ai"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp dst-port=443 tls-host="*workplace*" action=reject reject-with=tcp-reset comment="allowonly:whatsapp deny workplace"
add chain=forward src-address-list=allow-only-whatsapp dst-address-list=whatsapp-servers protocol=udp dst-port=443 action=drop comment="allowonly:whatsapp block QUIC"
add chain=forward src-address-list=allow-only-whatsapp dst-address-list=whatsapp-servers action=accept comment="allowonly:whatsapp allow"
add chain=forward src-address-list=allow-only-whatsapp dst-address-list=allowonly-checks protocol=tcp dst-port=80 action=accept comment="allowonly:whatsapp connectivity check"
add chain=forward src-address-list=allow-only-whatsapp dst-address-list=allowonly-gpush protocol=tcp dst-port=5228-5230 action=accept comment="allowonly:whatsapp Android push"
add chain=forward src-address-list=allow-only-whatsapp dst-address=17.0.0.0/8 protocol=tcp dst-port=5223 action=accept comment="allowonly:whatsapp Apple push"
add chain=forward src-address-list=allow-only-whatsapp protocol=tcp action=reject reject-with=tcp-reset comment="allowonly:whatsapp block rest"
add chain=forward src-address-list=allow-only-whatsapp action=reject reject-with=icmp-admin-prohibited comment="allowonly:whatsapp block rest"
# Above every other forward rule (fasttrack included), in this order.
move [find comment~"^allowonly:whatsapp"] destination=0
