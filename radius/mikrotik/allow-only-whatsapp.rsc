# MikrotikLover — ALLOW-ONLY profile: whatsapp (needs webfilter-base.rsc)
# Profile: WhatsApp only — chat, voice/video calls, photos/videos/voice notes, status, WhatsApp Web.
# Devices in address list "allow-only-whatsapp" can use ONLY this; every other site/app is blocked.
# Generated by radius/webfilter/build.sh from webfilter/allowonly/whatsapp.txt — edit that file, not this one.
#
# Put a device in address list "allow-only-whatsapp" and it can use only this profile:
#   static IP / subnet : /ip firewall address-list add list=allow-only-whatsapp address=192.168.88.50
#   by MAC (DHCP)      : /ip dhcp-server lease make-static [find mac-address=AA:BB:CC:DD:EE:FF]
#                        /ip dhcp-server lease set [find mac-address=AA:BB:CC:DD:EE:FF] address-lists=allow-only-whatsapp
#   hotspot (RADIUS)   : radius-admin group add whatsapp-only --address-list allow-only-whatsapp
#   WPA-Enterprise     : radius-admin group add whatsapp-only --vlan 50  + add that VLAN's subnet to the list
# IPv6 must be off for these devices (the lists are IPv4): no IPv6 address/RA on their network.
# Remove again: /ip firewall filter remove [find comment~"^allowonly:whatsapp"]; /ip firewall address-list remove [find comment~"^allowonly:whatsapp"]

/ip firewall address-list
remove [find comment~"^allowonly:whatsapp"]
add list=whatsapp-servers address=31.13.24.0/21 comment="allowonly:whatsapp"
add list=whatsapp-servers address=31.13.64.0/18 comment="allowonly:whatsapp"
add list=whatsapp-servers address=45.64.40.0/22 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.0.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.2.0/23 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.4.0/23 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.6.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.8.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.10.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.12.0/23 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.14.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.16.0/22 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.20.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.22.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.141.24.0/24 comment="allowonly:whatsapp"
add list=whatsapp-servers address=57.144.0.0/14 comment="allowonly:whatsapp"
add list=whatsapp-servers address=66.220.144.0/20 comment="allowonly:whatsapp"
add list=whatsapp-servers address=69.63.176.0/20 comment="allowonly:whatsapp"
add list=whatsapp-servers address=69.171.224.0/19 comment="allowonly:whatsapp"
add list=whatsapp-servers address=74.119.76.0/22 comment="allowonly:whatsapp"
add list=whatsapp-servers address=102.132.96.0/20 comment="allowonly:whatsapp"
add list=whatsapp-servers address=103.4.96.0/22 comment="allowonly:whatsapp"
add list=whatsapp-servers address=129.134.0.0/17 comment="allowonly:whatsapp"
