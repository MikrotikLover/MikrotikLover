# MikrotikLover web filter — category: video-streaming
# Video streaming / OTT
# Generated by radius/webfilter/build.sh from webfilter/categories/video-streaming.txt — edit that file, not this one.
# Needs webfilter-base.rsc. Remove the category again with:
#   /ip dns static remove [find comment="webfilter:video-streaming"]

/ip dns static
remove [find comment="webfilter:video-streaming"]
:do { /ip dns static add name=youtube.com type=NXDOMAIN match-subdomain=yes comment="webfilter:video-streaming" } on-error={}
:do { /ip dns static add name=youtu.be type=NXDOMAIN match-subdomain=yes comment="webfilter:video-streaming" } on-error={}
