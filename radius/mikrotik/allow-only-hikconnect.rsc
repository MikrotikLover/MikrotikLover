# MikrotikLover — ALLOW-ONLY profile: hikconnect (needs webfilter-base.rsc)
# Profile: Hik-Connect (Hikvision cameras) — the app, live view, playback and alarms.
# Used with "allow-only hikconnect" (alone or next to whatsapp) in a policy.
# Generated by radius/webfilter/build.sh from webfilter/allowonly/hikconnect.txt — edit that file, not this one.
#
# Put a device in address list "allow-only-hikconnect" and it can use only this profile:
#   static IP / subnet : /ip firewall address-list add list=allow-only-hikconnect address=192.168.88.50
#   by MAC (DHCP)      : /ip dhcp-server lease make-static [find mac-address=AA:BB:CC:DD:EE:FF]
#                        /ip dhcp-server lease set [find mac-address=AA:BB:CC:DD:EE:FF] address-lists=allow-only-hikconnect
#   hotspot (RADIUS)   : radius-admin user policy ali hikconnect-only   (policy file with: allow-only hikconnect)
#   WPA-Enterprise     : radius-admin group add hikconnect-only --vlan 50  + add that VLAN's subnet to the list
# IPv6 must be off for these devices (the lists are IPv4): no IPv6 address/RA on their network.
# Remove again: /ip firewall filter remove [find comment~"^allowonly:hikconnect"]; /ip firewall address-list remove [find comment~"^allowonly:hikconnect"]

/ip firewall address-list
remove [find comment~"^allowonly:hikconnect"]
:do { /ip firewall address-list add list=hikconnect-servers address=10.0.0.0/8 comment="allowonly:hikconnect" } on-error={}
:do { /ip firewall address-list add list=hikconnect-servers address=172.16.0.0/12 comment="allowonly:hikconnect" } on-error={}
:do { /ip firewall address-list add list=hikconnect-servers address=192.168.0.0/16 comment="allowonly:hikconnect" } on-error={}
/ip dns static
remove [find comment="allowonly:hikconnect dns"]
:do {
  :local up [:tostr [:pick [/ip dns get servers] 0]]
  :if ([:len $up] = 0) do={ :set up [:tostr [:pick [/ip dns get dynamic-servers] 0]] }
  :if ([:len $up] = 0) do={ :set up "1.1.1.1" }
  :local miss 0
  :do { /ip dns static add name=hik-connect.com match-subdomain=yes type=FWD forward-to=$up address-list=mlname-hik-connect.com address-list-timeout=1d comment="allowonly:hikconnect dns" } on-error={ :set miss ($miss + 1) }
  :do { /ip dns static add name=hikvision.com match-subdomain=yes type=FWD forward-to=$up address-list=mlname-hikvision.com address-list-timeout=1d comment="allowonly:hikconnect dns" } on-error={ :set miss ($miss + 1) }
  :if ($miss > 0) do={ :log warning "allow-only hikconnect: $miss DNS name(s) not added: already there from another file, or RouterOS older than 7.15" }
} on-error={ :log warning "allow-only hikconnect: DNS names not added (RouterOS 7.15+ needed)" }
/ip firewall address-list
# Phone/PC support: Wi-Fi "internet available" checks (HTTP only) and push notifications
remove [find comment="allowonly:support"]
add list=allowonly-checks address=connectivitycheck.gstatic.com comment="allowonly:support"
add list=allowonly-checks address=connectivitycheck.android.com comment="allowonly:support"
add list=allowonly-checks address=clients3.google.com comment="allowonly:support"
add list=allowonly-checks address=captive.apple.com comment="allowonly:support"
add list=allowonly-checks address=www.msftconnecttest.com comment="allowonly:support"
add list=allowonly-gpush address=mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt1-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt2-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt3-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt4-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt5-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt6-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt7-mtalk.google.com comment="allowonly:support"
add list=allowonly-gpush address=alt8-mtalk.google.com comment="allowonly:support"

/ip firewall filter
remove [find comment~"^allowonly:hikconnect"]
add chain=forward src-address-list=allow-only-hikconnect dst-address-list=hikconnect-servers action=accept comment="allowonly:hikconnect allow"
add chain=forward src-address-list=allow-only-hikconnect dst-address-list=mlname-hik-connect.com action=accept comment="allowonly:hikconnect allow hik-connect.com"
add chain=forward src-address-list=allow-only-hikconnect dst-address-list=mlname-hikvision.com action=accept comment="allowonly:hikconnect allow hikvision.com"
add chain=forward src-address-list=allow-only-hikconnect dst-address-list=allowonly-checks protocol=tcp dst-port=80 action=accept comment="allowonly:hikconnect connectivity check"
add chain=forward src-address-list=allow-only-hikconnect dst-address-list=allowonly-gpush protocol=tcp dst-port=5228-5230 action=accept comment="allowonly:hikconnect Android push"
add chain=forward src-address-list=allow-only-hikconnect dst-address=17.0.0.0/8 protocol=tcp dst-port=5223 action=accept comment="allowonly:hikconnect Apple push"
add chain=forward src-address-list=allow-only-hikconnect connection-state=new action=log log-prefix="WF-allowonly" limit=20/1m,10:packet comment="allowonly:hikconnect blocked (log)"
add chain=forward src-address-list=allow-only-hikconnect protocol=tcp action=reject reject-with=tcp-reset comment="allowonly:hikconnect block rest"
add chain=forward src-address-list=allow-only-hikconnect action=reject reject-with=icmp-admin-prohibited comment="allowonly:hikconnect block rest"
# Above every other forward rule (fasttrack included), in this order.
# above every other rule (destination=0 is not safe in a script: it stops the import when only these rules are there)
:do { :local o [/ip firewall filter find where !(comment~"^allowonly:hikconnect")]; :if ([:len $o] > 0) do={ /ip firewall filter move [/ip firewall filter find comment~"^allowonly:hikconnect"] destination=[:pick $o 0] } }
