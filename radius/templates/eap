# Managed by MikrotikLover radius/install.sh — re-running the installer overwrites this file.
#
# WPA2/WPA3-Enterprise: PEAP-MSCHAPv2 (Windows/Android/iOS/macOS default) and
# EAP-TTLS (PAP or MSCHAPv2 inside). The server certificate is signed by the
# private CA generated by the installer (certs/mikrotiklover/ca.pem).

eap {
	default_eap_type = peap
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_password = ""
		private_key_file = ${certdir}/mikrotiklover/server.key
		certificate_file = ${certdir}/mikrotiklover/server.pem
		ca_file = ${certdir}/mikrotiklover/ca.pem

		cipher_list = "DEFAULT"
		cipher_server_preference = no

		# TLS 1.3 inside PEAP/TTLS is still broken on many Windows/Android builds.
		tls_min_version = "1.2"
		tls_max_version = "1.2"

		ecdh_curve = ""

		cache {
			enable = no
		}

		verify {
		}

		ocsp {
			enable = no
		}
	}

	tls {
		tls = tls-common
	}

	ttls {
		tls = tls-common
		default_eap_type = mschapv2
		copy_request_to_tunnel = no
		# Pass per-user/per-group reply attributes (VLAN, rate limit,
		# Session-Timeout) from the inner tunnel to the MikroTik.
		use_tunneled_reply = yes
		virtual_server = "inner-tunnel"
	}

	peap {
		tls = tls-common
		default_eap_type = mschapv2
		copy_request_to_tunnel = no
		use_tunneled_reply = yes
		virtual_server = "inner-tunnel"
	}

	mschapv2 {
	}

	gtc {
		auth_type = PAP
	}

	md5 {
	}
}
