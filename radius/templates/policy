# Managed by MikrotikLover radius/install.sh — re-running the installer overwrites this file.
#
# MAC authentication: MikroTik sends the client MAC as User-Name in many formats
# (AA:BB:CC:DD:EE:FF, aabbccddeeff, AABB.CCDD.EEFF ...). Normalise it to
# AA-BB-CC-DD-EE-FF so it matches the "radius-admin mac add" entry, and normalise
# Calling-Station-Id the same way so the entry's "Calling-Station-Id ==" check
# (radius-admin stores it) only matches the real device, never a typed username.
# EAP (WPA-Enterprise) requests are left alone.
mikrotiklover_mac_normalize {
	if (!&EAP-Message && &User-Name && &User-Name =~ /^([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})$/i) {
		update request {
			&User-Name := "%{toupper:%{1}-%{2}-%{3}-%{4}-%{5}-%{6}}"
		}
	}
	rewrite_calling_station_id
}

# Hotspot business rules (plans, vouchers): expiry, data quota and daily time, from the SQL
# function ml_check() — see templates/functions.sql. Runs in authorize after -sql.
#   reject  -> Access-Reject with the reason in Reply-Message (shown on the hotspot login page)
#   accept  -> Session-Timeout = time left, Mikrotik-Total-Limit(+Gigawords) = data left
mikrotiklover_limits {
	update control {
		&Tmp-String-1 := "%{sql:SELECT ml_check('%{User-Name}')}"
	}
	if (&control:Tmp-String-1 =~ /^reject:(.+)$/) {
		update reply {
			&Reply-Message := "%{1}"
		}
		reject
	}
	if (&control:Tmp-String-1 =~ /^ok:([0-9]+):([0-9]+):([0-9]+):([01])$/) {
		update control {
			&Tmp-Integer-1 := "%{1}"
			&Tmp-Integer-2 := "%{2}"
			&Tmp-Integer-3 := "%{3}"
			&Tmp-Integer-4 := "%{4}"
		}
		if (&control:Tmp-Integer-1 > 0) {
			if (!&reply:Session-Timeout || (&reply:Session-Timeout > &control:Tmp-Integer-1)) {
				update reply {
					&Session-Timeout := &control:Tmp-Integer-1
				}
			}
		}
		if (&control:Tmp-Integer-4 == 1) {
			update reply {
				&Mikrotik-Total-Limit := &control:Tmp-Integer-2
				&Mikrotik-Total-Limit-Gigawords := &control:Tmp-Integer-3
			}
		}
	}
}

# First successful login of a plan user (post-auth): book the voucher sale, start validity.
mikrotiklover_activate {
	if (&control:Tmp-String-1 && (&control:Tmp-String-1 =~ /^ok:/)) {
		update control {
			&Tmp-String-2 := "%{sql:INSERT INTO ml_sale (username, plan, amount, kind) SELECT a.username, COALESCE(a.plan,''), b.price, 'voucher' FROM ml_account a JOIN ml_voucher_batch b ON b.id = a.voucher_batch WHERE a.username = '%{User-Name}' AND a.first_login IS NULL}"
			&Tmp-String-3 := "%{sql:UPDATE ml_account a LEFT JOIN ml_plan p ON p.name = a.plan SET a.first_login = NOW(), a.quota_since = COALESCE(a.quota_since, NOW()), a.expires_at = IF(a.expires_at IS NULL AND p.validity_seconds > 0, NOW() + INTERVAL p.validity_seconds SECOND, a.expires_at) WHERE a.username = '%{User-Name}' AND a.first_login IS NULL}"
		}
	}
}
